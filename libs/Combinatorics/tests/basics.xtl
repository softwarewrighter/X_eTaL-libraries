#!/usr/bin/env xetal
# Combinatorics: counting and listing. Run with "just run Combinatorics basics".
"cb:" u_se< "Combinatorics"
cb:f_actorial 0 1 5 10 20
2 cb:c_hoose 5
(o_ffsets 7) cb:c_hoose 6            # a row of Pascal's triangle
30 cb:c_hoose 60                     # exact, though 60! overflows
2 cb:c_ombinations 4
s_hape 3 cb:c_ombinations 6
cb:p_ermutations 3
s_hape cb:p_ermutations 5
cb:s_ubsets 3
cb:p_owerset "abc"
1 2 cb:p_roduct 7 8 9
s_hape 0 cb:c_ombinations 3
s_hape 4 cb:c_ombinations 3
cb:s_ubsets 2                        # (the example on the page)
