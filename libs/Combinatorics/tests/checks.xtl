#!/usr/bin/env xetal
# Combinatorics, checked with Check: the lists have the counted sizes.
"cb:" u_se< "Combinatorics"
"ch:" u_se< "Check"
c1 := "C(7,3) rows" ch:t_est (3 cb:c_hoose 7) ch:i_s t_ally 3 cb:c_ombinations 7
m := 3 cb:c_ombinations 7
c2 := "rows increase" ch:t_est ch:t_rue (-1 d_rop_2 m) < 1 d_rop_2 m
p := cb:p_ermutations 5
c3 := "5! permutations" ch:t_est (cb:f_actorial 5) ch:i_s t_ally p
c4 := "permutations distinct" ch:t_est (t_ally p) ch:i_s t_ally u_nique p
c5 := "each row a permutation" ch:t_est ch:t_rue '{ i -> (r_ange 5) m_atch s_ort i s_elect p } e_ach r_ange 120
c6 := "sorted" ch:t_est p ch:i_s s_ort p
c7 := "2^n subsets" ch:t_est 32 ch:i_s t_ally cb:s_ubsets 5
c8 := "Pascal sums" ch:t_est (2 ^ 10) ch:i_s '+ r_/ (o_ffsets 11) cb:c_hoose 10
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4 ch:a_nd c5 ch:a_nd c6 ch:a_nd c7 ch:a_nd c8
