#!/usr/bin/env xetal
# Grouping, checked with Check.
"gr:" u_se< "Grouping"
"ch:" u_se< "Check"
k := 3 1 3 2 1 3 3 2
v := 10 20 30 40 50 60 70 80
c1 := "counts add to the length" ch:t_est (t_ally k) ch:i_s '+ r_/ gr:c_ount k
c2 := "sums add to the total" ch:t_est ('+ r_/ v) ch:i_s '+ r_/ k gr:s_um v
c3 := "groups hold every value" ch:t_est (s_ort v) ch:i_s s_ort d_isclose '{ e_nclose (d_isclose _l) c_at d_isclose _r } r_/ k gr:g_roups v
c4 := "mean is sum over count" ch:t_est ((f_loat k gr:s_um v) / f_loat gr:c_ount k) ch:n_ear k gr:m_ean v
c5 := "least <= greatest" ch:t_est ch:t_rue (k gr:l_east v) <= k gr:g_reatest v
c6 := "b_y with the sum is s_um" ch:t_est (k gr:s_um v) ch:i_s k '{ '+ r_/ _r } gr:b_y v
c7 := "one key is the whole" ch:t_est (1 r_eshape '+ r_/ v) ch:i_s (8 r_eshape 0) gr:s_um v
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4 ch:a_nd c5 ch:a_nd c6 ch:a_nd c7
