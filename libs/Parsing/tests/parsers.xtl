#!/usr/bin/env xetal
# The parsers, through macros that show what they give. Run with
# "just run Parsing parsers".
"p:" u_se< "Probe.xtlm"
@ p:p_arts< "a + b - c"
@ p:p_arts< "-a + b"
@ p:b_inding< "sum i:=0..n - 1"
@ p:a_pplied< "max(a, f(b, c))"
@ p:r_eference< "X[c, h+r]"
@ p:l_etters< "only letters"
@ p:w_hole< "a + b"
