#!/usr/bin/env xetal
# Parsing: the pieces. Run with "just run Parsing basics".
"pa:" u_se< "Parsing"
pa:s_queeze "a + b"
"+-" pa:t_op "a + (b - c)"
"+-" pa:t_op "a + f(b - c) - d"
"," pa:s_plit "a, f(b, c), d"
":=" pa:a_t "i:=0..n"
("(", ")") pa:c_losed "(a)(b)"
("(", ")") pa:c_losed "(a (b) c)"
pa:g_roup? "((a) + b)"
pa:i_nner "(a + b)"
pa:n_ame? "x2"
pa:n_ame? "X2"
pa:n_umber? "2.5"
pa:n_umber? "2."
pa:w_ord? "nn:r_elu"
pa:a_pplied? "exp(x)"
pa:a_pplied? "exp(x) + 1"
pa:a_pplied? "x"
("(", ")") pa:c_losed ""
