## Matrix: matrices -- identity, diagonal, trace, product,
## determinant, inverse, solving linear systems, orthonormal bases,
## projection onto a subspace and coordinates in a basis, eigenvalues and
## eigenvectors of a symmetric matrix, singular values and the best
## rank-k approximation.
## Import it with an alias of your choice: "mx:" u_se< "Matrix".
## Put libs/Matrix/src on XETAL_PATH ("just path"); the reference is libs/Matrix/docs.
## Names with l: are exported; those under h: are private to this file.
##
## A matrix is a rank-2 array, rows first. The numerical functions
## (d_et, i_nverse, s_olve) work in Floats, by Gaussian elimination with
## partial pivoting; compare their results with Check's ch:n_ear. The
## transpose is the built-in o_\.

### Basics

## i_dentity n: the n by n identity matrix (1 then n zeros, cycled).
l:i_dentity := { n -> (n c_at n) r_eshape 1 c_at n r_eshape 0 }

## d_iag m: the items on the main diagonal.
l:d_iag := { m ->
  k := 'm_in r_/ s_hape m
  (1 + (o_ffsets k) * 1 + f_irst r_ev s_hape m) s_elect r_avel m
}

## t_race m: the sum of the diagonal.
l:t_race := { m -> '+ r_/ l:d_iag m }

## a m_ul b: the matrix product (a matrix and a vector work too).
l:m_ul := { a b -> a '+ '* i_nner b }

### Solving

## The permutation of 1..n that swaps i and j.
h:s_wapping := { n i j ->
  r := r_ange n
  r + ((r = i) * j - i) + (r = j) * i - j
}

## The row (k..n) whose item in column k is largest in size.
h:p_ivot := { k m ->
  c := a_bs (k - 1) d_rop k s_elect_2 m
  k + (f_irst g_rade n_eg c) - 1
}

## Gauss-Jordan on m (Float) for columns k..n of its first n: each
## column's pivot row moved up, scaled to 1, and the column cleared
## from every other row.
h:g_j := { n k m ->
  k > n ? m
  s := ((n h:s_wapping k)_ k h:p_ivot m) s_elect m
  r := r_ange t_ally s
  v := f_irst k s_elect k s_elect_2 s         # the pivot
  0.000000000001 > a_bs v ? @ p_anic< "the matrix is singular: it has no inverse, and its system no unique solution"
  row := (k s_elect s) / v
  c := (k s_elect_2 s) - f_loat r = k
  ((n h:g_j k + 1)_ s - c '* t_able row)
}

## b s_olve a: x with a m_ul x = b, for a square a; b is a vector or a
## matrix of right-hand sides (one per column). A singular a divides by
## zero (error[division-by-zero]).
l:s_olve := { b a ->
  n := t_ally a
  x := n d_rop_2 ((n h:g_j 1)_ f_loat a c_at_2 b)
  (s_hape b) r_eshape x
}

## i_nverse a: the inverse of a square matrix.
l:i_nverse := { a -> (l:i_dentity t_ally a) l:s_olve a }

### Determinant

## The determinant of a Float matrix m, by elimination: the first pivot
## times the determinant of what is left, negated for a row swap.
h:d_etF := { m ->
  n := t_ally m
  n = 1 ? f_irst r_avel m
  p := 1 h:p_ivot m
  w := ((n h:s_wapping 1)_ p) s_elect m
  v := f_irst r_avel w
  v = 0 ? 0.0
  s := f_loat (p = 1) - p != 1
  r := (1 d_rop_2 1 d_rop w) - ((1 d_rop f_irst_2 w) / v) '* t_able 1 d_rop f_irst w
  s * v * h:d_etF r
}

## d_et a: the determinant of a square matrix.
l:d_et := { a -> h:d_etF f_loat a }

### Subspaces

## The tolerance of a dependent row: a remainder no longer than this
## fraction of its row's own length is counted as 0.
h:t_ol := { u -> 0.0000000001 }

## The length of the vector v.
h:l_ength := { v -> s_qrt '+ r_/ v * v }

## q o_rth v: v less its projection onto the rows of q (orthonormal,
## possibly none).
h:o_rth := { q v -> v - (q '+ '* i_nner v) '+ '* i_nner q }

## Modified Gram-Schmidt from row i of b on, the orthonormal rows so
## far in q: each row's remainder taken twice (once leaves rounding of
## the size of the projection; twice is orthogonal to the last digits)
## and kept, made unit length, unless it is within the tolerance of 0.
h:g_s := { b i q ->
  i > t_ally b ? q
  v := i s_elect b
  w := q h:o_rth q h:o_rth v
  r := h:l_ength w
  r <= (h:t_ol @) * h:l_ength v ? ((b h:g_s i + 1)_ q)
  ((b h:g_s i + 1)_ q c_at (1 c_at t_ally w) r_eshape w / r)
}

## o_rthonormal b: an orthonormal basis of the span of b's rows, as
## rows: modified Gram-Schmidt, twice, in row order, so the first row
## of the result is the first nonzero row of b made unit length. A row
## within 1e-10 of its own length of the span of the rows before it is
## dependent and dropped, so the result has as many rows as b's rank.
l:o_rthonormal := { b ->
  f := f_loat b
  ((f h:g_s 1)_ (0 c_at f_irst r_ev s_hape f) r_eshape 0.0)
}

## r_ank b: the dimension of the span of b's rows, the number of rows
## of its orthonormal basis (to the same tolerance).
l:r_ank := { b -> t_ally l:o_rthonormal b }

## b p_roject m: each row of m (or the vector m) projected onto the span
## of b's rows: its nearest point there, m Q' Q for Q the orthonormal
## basis of b's rows. b's rows need not be independent or orthonormal.
l:p_roject := { b m ->
  q := l:o_rthonormal b
  ((f_loat m) '+ '* i_nner o_\ q) '+ '* i_nner q
}

## b r_emainder m: what is left of m after its projection, m less
## b p_roject m: orthogonal to every row of b.
l:r_emainder := { b m -> (f_loat m) - b l:p_roject m }

## b c_oordinates m: the coordinates of each row of m (or the vector m)
## in the rows of b: c with c mx:m_ul b equal to m, for m in the span;
## for m outside it, the coordinates of its projection. b's rows must be
## independent (else the coordinates are not unique): solved in b's
## orthonormal basis Q, as c R = m Q' with R = b Q', so b b' is never
## inverted.
l:c_oordinates := { b m ->
  q := l:o_rthonormal b
  (t_ally q) < t_ally b ? @ p_anic< "the rows of the basis are dependent: coordinates in it are not unique"
  r := (f_loat b) '+ '* i_nner o_\ q
  a := (f_loat m) '+ '* i_nner o_\ q
  o_\ (o_\ a) l:s_olve o_\ r
}

### Symmetric eigenvalues

## Jacobi's stopping point: the off-diagonal part's length (Frobenius) at
## most this fraction of the whole matrix's.
h:j_acobiTol := { u -> 0.000000000000001 }

## The most sweeps Jacobi makes before it stops with a message.
h:j_acobiSweeps := { u -> 30 }

## The length (Frobenius) of a matrix: every item squared, summed, rooted.
h:f_robenius := { a -> s_qrt '+ r_/ r_avel a * a }

## The off-diagonal part of the square matrix a, the diagonal zeroed.
h:o_ff := { a -> a * f_loat 0 = l:i_dentity t_ally a }

## The rotation that zeroes item (p, q) of the symmetric a, as a full
## n by n matrix j (j' a j has 0 there): from tau = (a_qq - a_pp) / 2 a_pq,
## t = sign(tau) / (|tau| + sqrt(1 + tau^2)) (the smaller angle; an
## overflowing tau^2 makes t 0, no rotation), c = 1 / sqrt(1 + t^2),
## s = t c (Golub and Van Loan, sym.schur2). An item already 0 is left.
h:r_otation := { a p q ->
  n := t_ally a
  i := f_loat l:i_dentity n
  apq := f_irst q s_elect p s_elect a
  0.0 = apq ? i
  tau := ((f_irst q s_elect q s_elect a) - f_irst p s_elect p s_elect a) / 2.0 * apq
  t := (1.0 - 2.0 * f_loat tau < 0.0) / (a_bs tau) + s_qrt 1.0 + tau * tau
  c := 1.0 / s_qrt 1.0 + t * t
  ep := f_loat (r_ange n) = p
  eq := f_loat (r_ange n) = q
  i + ((c - 1.0) * (ep '* t_able ep) + eq '* t_able eq) + (t * c) * (ep '* t_able eq) - eq '* t_able ep
}

## One cyclic sweep: a rotation for every pair p < q in row order,
## applied to a (j' a j) and gathered in v (v j); the state (a, v).
h:s_weep := { (a, v) ->
  n := t_ally a
  k := (w_here r_avel (r_ange n) '< t_able r_ange n) - 1
  ps := 1 + k d_iv n
  qs := 1 + k m_od n
  r_ot := { (i, b, w) ->
    j := ((b h:r_otation i s_elect ps)_ i s_elect qs)
    (i + 1, (o_\ j) l:m_ul b l:m_ul j, w l:m_ul j)
  }
  (_, b, w) := (t_ally k) 'r_ot p_ower (1, a, v)
  (b, w)
}

## Sweeps until the off-diagonal part is within the tolerance of the
## whole (or stop at the cap with a message); k sweeps made so far.
h:s_weeps := { k (a, v) ->
  (h:f_robenius h:o_ff a) <= (h:j_acobiTol @) * h:f_robenius a ? (a, v)
  k >= h:j_acobiSweeps @ ? @ p_anic< "Jacobi did not converge in 30 sweeps"
  (k + 1) h:s_weeps h:s_weep (a, v)
}

## The eigenvalues of the symmetric s, descending, and its eigenvectors
## as rows in the same order, each signed so its largest item (the first
## of equal ones) is positive. s must be square and symmetric (to 1e-12
## of its largest item); it is not symmetrized.
h:e_igen := { s ->
  a := f_loat s
  n := t_ally a
  n_ot (n c_at n) m_atch s_hape a ? @ p_anic< "the matrix is not square"
  big := 'm_ax r_/ 0.0 c_at r_avel a_bs a
  n_ot '& r_/ r_avel (a_bs a - o_\ a) <= 0.000000000001 * big ? @ p_anic< "the matrix is not symmetric: eigenvalues here are for symmetric matrices only"
  (d, v) := 0 h:s_weeps (a, f_loat l:i_dentity n)
  o := g_rade n_eg l:d_iag d
  w := o s_elect o_\ v
  ones := n r_eshape 1.0
  hit := f_loat (a_bs w) = ('m_ax r_/_2 a_bs w) '* t_able ones
  first := hit * f_loat 1.0 = '+ s_\_2 hit
  sg := 1.0 - 2.0 * f_loat 0.0 > '+ r_/_2 w * first
  (o s_elect l:d_iag d, w * sg '* t_able ones)
}

## e_igenvalues s: the eigenvalues of the symmetric matrix s, largest
## first, by cyclic Jacobi.
l:e_igenvalues := { s -> (vals, _) := h:e_igen s; vals }

## e_igenvectors s: the eigenvectors of the symmetric matrix s, one per
## row, in the order of e_igenvalues; each of unit length, signed so its
## largest item is positive: s is (o_\ v) times diag(values) times v.
l:e_igenvectors := { s -> (_, vecs) := h:e_igen s; vecs }

### Singular values

## Whether the rows of a are orthogonal: every pair's dot product at most
## the tolerance times the product of their lengths.
h:o_rthogonal? := { a ->
  g := a l:m_ul o_\ a
  dg := l:d_iag g
  '& r_/ r_avel (a_bs h:o_ff g) <= (h:j_acobiTol @) * s_qrt dg '* t_able dg
}

## One sweep of one-sided Jacobi on the rows of a: for every pair p < q,
## the rotation that makes rows p and q orthogonal (the Jacobi rotation
## of their Gram matrix, a a'), applied to a and gathered in v.
h:s_vdSweep := { (a, v) ->
  n := t_ally a
  k := (w_here r_avel (r_ange n) '< t_able r_ange n) - 1
  ps := 1 + k d_iv n
  qs := 1 + k m_od n
  r_ot := { (i, b, w) ->
    j := (((b l:m_ul o_\ b) h:r_otation i s_elect ps)_ i s_elect qs)
    (i + 1, (o_\ j) l:m_ul b, (o_\ j) l:m_ul w)
  }
  (_, b, w) := (t_ally k) 'r_ot p_ower (1, a, v)
  (b, w)
}

## Sweeps until the rows are orthogonal (or stop at the cap).
h:s_vdSweeps := { k (a, v) ->
  h:o_rthogonal? a ? (a, v)
  k >= h:j_acobiSweeps @ ? @ p_anic< "Jacobi did not converge in 30 sweeps"
  (k + 1) h:s_vdSweeps h:s_vdSweep (a, v)
}

## The thin SVD of m with at least as many rows as columns: one-sided
## Jacobi on the rows of m' (m itself is never squared), so the rows end
## orthogonal, of lengths the singular values, along the left singular
## vectors; v gathers the rotations, the right ones. Largest first, each
## v row signed so its largest item is positive.
h:s_vdTall := { m ->
  n := f_irst r_ev s_hape m
  (a, v) := 0 h:s_vdSweeps (o_\ m, f_loat l:i_dentity n)
  s := s_qrt '+ r_/_2 a * a
  o := g_rade n_eg s
  ones := n r_eshape 1.0
  ss := o s_elect s
  u := (o s_elect a) / (ss + f_loat ss = 0.0) '* t_able (t_ally f_irst a) r_eshape 1.0
  w := o s_elect v
  hit := f_loat (a_bs w) = ('m_ax r_/_2 a_bs w) '* t_able ones
  first := hit * f_loat 1.0 = '+ s_\_2 hit
  sg := 1.0 - 2.0 * f_loat 0.0 > '+ r_/_2 w * first
  (u * sg '* t_able (t_ally f_irst u) r_eshape 1.0, ss, w * sg '* t_able ones)
}

## s_vd m: the singular value decomposition, (u, s, v) with m equal to
## (o_\ u) mx:m_ul diag(s) mx:m_ul v: s the singular values, largest
## first, as many as m's smaller side; u's rows the left singular
## vectors, v's the right ones, orthonormal (a row for a singular value
## of 0 is 0 in u). One-sided Jacobi on m (or on m', for a wide m).
l:s_vd := { m ->
  f := f_loat m
  (r, c) := (f_irst s_hape f, f_irst r_ev s_hape f)
  r >= c ? h:s_vdTall f
  (u, s, v) := h:s_vdTall o_\ f
  (v, s, u)
}

## s_ingular m: the singular values of the matrix m, largest first, as
## many as its smaller side.
l:s_ingular := { m -> (_, s, _) := l:s_vd m; s }

## k t_runcate m: the best approximation of m of rank at most k (Eckart
## and Young: nearest in both the Frobenius and the spectral norm), its
## k largest singular values kept and the rest made 0; m itself when k
## is at least its smaller side.
l:t_runcate := { k m ->
  (u, s, v) := l:s_vd m
  j := k m_in t_ally s
  (o_\ j t_ake u) l:m_ul ((j t_ake s) '* t_able (f_irst r_ev s_hape v) r_eshape 1.0) * j t_ake v
}
