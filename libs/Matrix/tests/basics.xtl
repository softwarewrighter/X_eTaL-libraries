#!/usr/bin/env xetal
# Matrix: the basics. Run with "just run Matrix basics".
"mx:" u_se< "Matrix"
a := 2 3 r_eshape r_ange 6
o_\ a
mx:i_dentity 3
mx:d_iag a
mx:t_race 3 3 r_eshape r_ange 9
a mx:m_ul o_\ a
s := 3 3 r_eshape 2 1 1 1 3 2 1 0 0
mx:d_et s
mx:d_et 2 2 r_eshape 1 2 2 4         # singular
mx:d_et mx:i_dentity 4
4 5 6 mx:s_olve s                    # s m_ul x is 4 5 6
mx:i_nverse s
mx:i_nverse 2 2 r_eshape 4 7 2 6
mx:o_rthonormal 2 3 r_eshape 3 4 0  1 1 1     # (0.6, 0.8, 0), then (1, 1, 1) less its part along it, unit length
mx:r_ank 3 3 r_eshape 1 2 3  2 4 6  0 0 1     # 2: the second row is twice the first
(2 3 r_eshape 1 0 0  0 1 0) mx:p_roject 3 4 5    # onto the xy plane: 3 4 0
(2 3 r_eshape 1 0 0  0 1 0) mx:r_emainder 3 4 5  # what is left: 0 0 5
(2 2 r_eshape 1 0  1 1) mx:c_oordinates 3 5      # -2 5: -2 (1, 0) + 5 (1, 1) is (3, 5)
mx:e_igenvalues 2 2 r_eshape 2 1  1 2           # 3 and 1
mx:e_igenvectors 2 2 r_eshape 2 1  1 2          # (1, 1) and (1, -1), unit length
mx:s_ingular 2 2 r_eshape 3 0  4 5              # 3 sqrt 5 and sqrt 5
1 mx:t_runcate 2 2 r_eshape 3 0  4 5            # the best rank 1: 1.5 1.5 over 4.5 4.5
