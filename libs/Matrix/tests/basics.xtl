#!/usr/bin/env xetal
# Matrix: the basics. Run with "just run Matrix basics".
"mx:" u_se< "Matrix"
a := 2 3 r_eshape r_ange 6
o_\ a
mx:i_dentity 3
mx:d_iag a
mx:t_race 3 3 r_eshape r_ange 9
a mx:m_ul o_\ a
s := 3 3 r_eshape 2 1 1 1 3 2 1 0 0
mx:d_et s
mx:d_et 2 2 r_eshape 1 2 2 4         # singular
mx:d_et mx:i_dentity 4
4 5 6 mx:s_olve s                    # s m_ul x is 4 5 6
mx:i_nverse s
mx:i_nverse 2 2 r_eshape 4 7 2 6
