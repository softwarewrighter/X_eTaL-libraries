#!/usr/bin/env xetal
# Format, checked with Check: the texts read back as the numbers.
"f:" u_se< "Format"
"ch:" u_se< "Check"
v := 3.14159 -2.5 1234.567 0.001 -0.004
back := n_umbers " " t:j_oin 3 f:f_ixed v
"t:" u_se< "Strings"
c1 := "fixed reads back rounded" ch:t_est (f_loat 3.142 -2.5 1234.567 0.001 -0.004) ch:n_ear back
c2 := "fixed has n decimals" ch:t_est (5 r_eshape 3) ch:i_s '{ c := d_isclose _r; (t_ally c) - f_irst w_here c = f_irst "." } e_ach 3 f:f_ixed v
c3 := "thousands without commas" ch:t_est "1234567" ch:i_s "," "" t:r_eplace d_isclose f_irst f:t_housands 1234567
c4 := "a column is one width" ch:t_est 2 ch:i_s t_ally s_hape f:c_olumn 1 f:f_ixed 1 22 333
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4
