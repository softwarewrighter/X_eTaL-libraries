#!/usr/bin/env xetal
# Bits, checked with Check: the laws of bitwise logic.
"b:" u_se< "Bits"
"ch:" u_se< "Check"
a := 0 1 6 255 1000 123456789
b := 3 1 5 128 24 987654321
c1 := "xor twice is the identity" ch:t_est a ch:i_s (a b:x_or b) b:x_or b
c2 := "and plus or is the sum" ch:t_est (a + b) ch:i_s (a b:a_nd b) + a b:o_r b
c3 := "xor is or minus and" ch:t_est (a b:x_or b) ch:i_s (a b:o_r b) - a b:a_nd b
c4 := "bits and back" ch:t_est a ch:i_s b:v_alue 32 b:b_its a
c5 := "popcount of a mask" ch:t_est (r_ange 10) ch:i_s b:p_opcount b:m_ask r_ange 10
c6 := "shift left then right" ch:t_est a ch:i_s 5 b:s_hr 5 b:s_hl a
g := b:g_ray o_ffsets 256
c7 := "Gray neighbors differ in one bit" ch:t_est (255 r_eshape 1) ch:i_s b:p_opcount (1 d_rop g) b:x_or -1 d_rop g
c8 := "Gray codes undo" ch:t_est (o_ffsets 256) ch:i_s b:u_ngray g
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4 ch:a_nd c5 ch:a_nd c6 ch:a_nd c7 ch:a_nd c8
