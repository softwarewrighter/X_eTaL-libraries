#!/usr/bin/env xetal
## A table's columns as named, typed variables: c_olumns< reads the
## schema when the program is compiled and writes a definition per
## column, so the program speaks of city and population, and their
## kinds are checked like any variable's. Run with "just demo Csv schema".

"cs:" u_se< "Csv"
"s:" u_se< "Stats"
t := cs:r_ows ("city,country,population,area\nOslo,Norway,709037,454\n\"Washington, D.C.\",USA,678972,177\nLima,Peru,10092000,2672\nPerth,Australia,2192229,6418\nTurin,Italy,848885,130\n")         # the data, built in from the file beside this program
city := (1 d_rop ((f_irst t) i_ndexOf e_nclose "city") s_elect_2 t)
population := n_umbers d_isclose '{ e_nclose (d_isclose _l) c_at " " c_at d_isclose _r } r_/ (1 d_rop ((f_irst t) i_ndexOf e_nclose "population") s_elect_2 t)
area := n_umbers d_isclose '{ e_nclose (d_isclose _l) c_at " " c_at d_isclose _r } r_/ (1 d_rop ((f_irst t) i_ndexOf e_nclose "area") s_elect_2 t)
city
population / area                         # people per square kilometre
d_isclose (f_irst g_rade n_eg population / area) s_elect city   # the densest
s:m_ean population

