#!/usr/bin/env xetal
# Csv, checked with Check: round trips.
"cs:" u_se< "Csv"
"ch:" u_se< "Check"
text := "id,note,score\n1,\"a, b\",2.5\n2,\"he said \"\"no\"\"\",3\n3,,4\n"
t := cs:r_ows text
c1 := "four rows of three" ch:t_est 4 3 ch:i_s s_hape t
c2 := "text then rows is the table" ch:t_est t ch:i_s cs:r_ows cs:t_ext t
c3 := "a comma inside quotes" ch:t_est "a, b" ch:i_s d_isclose f_irst "note" cs:f_ield t
c4 := "a doubled quote" ch:t_est "he said \"no\"" ch:i_s d_isclose 2 s_elect "note" cs:f_ield t
c5 := "an empty field" ch:t_est 0 ch:i_s t_ally d_isclose 3 s_elect "note" cs:f_ield t
c6 := "numbers of a column" ch:t_est 2.5 3.0 4.0 ch:n_ear "score" cs:n_umbers t
c7 := "a column by number" ch:t_est ("score" cs:f_ield t) ch:i_s 3 cs:c_olumn t
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4 ch:a_nd c5 ch:a_nd c6 ch:a_nd c7
