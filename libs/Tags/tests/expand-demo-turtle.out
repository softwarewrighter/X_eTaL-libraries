#!/usr/bin/env xetal
## A turtle on a grid: its heading is one of four choices, its state a
## tagged tuple of a position, a heading and a count of steps -- parts of
## different types, used by name. e_num< names the choices, p_arts< the
## parts; both write plain definitions when the program is compiled.
## Turns and moves are tables indexed by the heading, not branches.
## Run with "just demo Tags turtle".

"tg:" u_se< "Tags"
NORTH := 1
EAST := 2
SOUTH := 3
WEST := 4
HEADING := "north" "east" "south" "west"
TURTLE := "Turtle"
u:t_urtle := { (at, heading, steps) -> (TURTLE, at, heading, steps) }
u:t_urtle? := { (g1:tag, _, _, _) -> g1:tag m_atch TURTLE }
u:t_urtleAt := { (g1:tag, g2:part, _, _) ->
  n_ot g1:tag m_atch TURTLE ? "wrong-kind" []S_IGNAL "expected a Turtle"
  g2:part
}
u:t_urtleHeading := { (g1:tag, _, g2:part, _) ->
  n_ot g1:tag m_atch TURTLE ? "wrong-kind" []S_IGNAL "expected a Turtle"
  g2:part
}
u:t_urtleSteps := { (g1:tag, _, _, g2:part) ->
  n_ot g1:tag m_atch TURTLE ? "wrong-kind" []S_IGNAL "expected a Turtle"
  g2:part
}
u:s_etTurtleAt := { g3:new (g1:tag, at, heading, steps) ->
  n_ot g1:tag m_atch TURTLE ? "wrong-kind" []S_IGNAL "expected a Turtle"
  _ := g3:new m_atch at
  (g1:tag, g3:new, heading, steps)
}
u:s_etTurtleHeading := { g3:new (g1:tag, at, heading, steps) ->
  n_ot g1:tag m_atch TURTLE ? "wrong-kind" []S_IGNAL "expected a Turtle"
  _ := g3:new m_atch heading
  (g1:tag, at, g3:new, steps)
}
u:s_etTurtleSteps := { g3:new (g1:tag, at, heading, steps) ->
  n_ot g1:tag m_atch TURTLE ? "wrong-kind" []S_IGNAL "expected a Turtle"
  _ := g3:new m_atch steps
  (g1:tag, at, heading, g3:new)
}
u:t_urtleRows := { g4:which (g1:tag, at, heading, steps) -> (g1:tag, g4:which s_elect at, g4:which s_elect heading, g4:which s_elect steps) }
RIGHT := EAST c_at SOUTH c_at WEST c_at NORTH        # the heading after a right turn, by heading
LEFT := WEST c_at NORTH c_at EAST c_at SOUTH
MOVE := 4 2 r_eshape 0 1 1 0 0 -1 -1 0             # a step's x and y, by heading
## u:f_orward s: one step the way the turtle faces, counted.
u:f_orward := { s ->
  next := (u:t_urtleAt s) + (u:t_urtleHeading s) s_elect MOVE
  next u:s_etTurtleAt (1 + u:t_urtleSteps s) u:s_etTurtleSteps s
}
## u:r_ight s and u:l_eft s: a quarter turn, by table.
u:r_ight := { s -> ((u:t_urtleHeading s) s_elect RIGHT) u:s_etTurtleHeading s }
u:l_eft := { s -> ((u:t_urtleHeading s) s_elect LEFT) u:s_etTurtleHeading s }
start := u:t_urtle (0 0, NORTH, 0)
start
up := 3 'u:f_orward p_ower start                   # three steps north
over := 2 'u:f_orward p_ower u:r_ight up            # right, two steps east
back := u:f_orward u:l_eft u:l_eft over             # about turn, one step west
back
"now at " c_at (f_ormat u:t_urtleAt back) c_at ", facing " c_at (d_isclose (u:t_urtleHeading back) s_elect HEADING) c_at ", after " c_at (f_ormat u:t_urtleSteps back) c_at " steps"

