#!/usr/bin/env xetal
# Any part names work, even tag and new: the written functions take
# their own names from []G_ENSYM (g1:tag, g3:new), never a part's.
"tg:" u_se< "Tags"
BOX := "Box"
u:b_ox := { (tag, new, a, b) -> (BOX, tag, new, a, b) }
u:b_ox? := { (g1:tag, _, _, _, _) -> g1:tag m_atch BOX }
u:b_oxTag := { (g1:tag, g2:part, _, _, _) ->
  n_ot g1:tag m_atch BOX ? "wrong-kind" []S_IGNAL "expected a Box"
  g2:part
}
u:b_oxNew := { (g1:tag, _, g2:part, _, _) ->
  n_ot g1:tag m_atch BOX ? "wrong-kind" []S_IGNAL "expected a Box"
  g2:part
}
u:b_oxA := { (g1:tag, _, _, g2:part, _) ->
  n_ot g1:tag m_atch BOX ? "wrong-kind" []S_IGNAL "expected a Box"
  g2:part
}
u:b_oxB := { (g1:tag, _, _, _, g2:part) ->
  n_ot g1:tag m_atch BOX ? "wrong-kind" []S_IGNAL "expected a Box"
  g2:part
}
u:s_etBoxTag := { g3:new (g1:tag, tag, new, a, b) ->
  n_ot g1:tag m_atch BOX ? "wrong-kind" []S_IGNAL "expected a Box"
  _ := g3:new m_atch tag
  (g1:tag, g3:new, new, a, b)
}
u:s_etBoxNew := { g3:new (g1:tag, tag, new, a, b) ->
  n_ot g1:tag m_atch BOX ? "wrong-kind" []S_IGNAL "expected a Box"
  _ := g3:new m_atch new
  (g1:tag, tag, g3:new, a, b)
}
u:s_etBoxA := { g3:new (g1:tag, tag, new, a, b) ->
  n_ot g1:tag m_atch BOX ? "wrong-kind" []S_IGNAL "expected a Box"
  _ := g3:new m_atch a
  (g1:tag, tag, new, g3:new, b)
}
u:s_etBoxB := { g3:new (g1:tag, tag, new, a, b) ->
  n_ot g1:tag m_atch BOX ? "wrong-kind" []S_IGNAL "expected a Box"
  _ := g3:new m_atch b
  (g1:tag, tag, new, a, g3:new)
}
u:b_oxRows := { g4:which (g1:tag, tag, new, a, b) -> (g1:tag, g4:which s_elect tag, g4:which s_elect new, g4:which s_elect a, g4:which s_elect b) }
x := u:b_ox ("lid", 2, 3.5, 0 1)
u:b_oxTag x
u:b_oxA x
7 u:s_etBoxNew x

