#!/usr/bin/env xetal
# A tagged tuple whose parts are columns: a table, used by name, and
# rows taken from every column at once.
"tg:" u_se< "Tags"
PEOPLE := "People"
u:p_eople := { (name, age, score) -> (PEOPLE, name, age, score) }
u:p_eople? := { (g1:tag, _, _, _) -> g1:tag m_atch PEOPLE }
u:p_eopleName := { (g1:tag, g2:part, _, _) ->
  n_ot g1:tag m_atch PEOPLE ? "wrong-kind" []S_IGNAL "expected a People"
  g2:part
}
u:p_eopleAge := { (g1:tag, _, g2:part, _) ->
  n_ot g1:tag m_atch PEOPLE ? "wrong-kind" []S_IGNAL "expected a People"
  g2:part
}
u:p_eopleScore := { (g1:tag, _, _, g2:part) ->
  n_ot g1:tag m_atch PEOPLE ? "wrong-kind" []S_IGNAL "expected a People"
  g2:part
}
u:s_etPeopleName := { g3:new (g1:tag, name, age, score) ->
  n_ot g1:tag m_atch PEOPLE ? "wrong-kind" []S_IGNAL "expected a People"
  _ := g3:new m_atch name
  (g1:tag, g3:new, age, score)
}
u:s_etPeopleAge := { g3:new (g1:tag, name, age, score) ->
  n_ot g1:tag m_atch PEOPLE ? "wrong-kind" []S_IGNAL "expected a People"
  _ := g3:new m_atch age
  (g1:tag, name, g3:new, score)
}
u:s_etPeopleScore := { g3:new (g1:tag, name, age, score) ->
  n_ot g1:tag m_atch PEOPLE ? "wrong-kind" []S_IGNAL "expected a People"
  _ := g3:new m_atch score
  (g1:tag, name, age, g3:new)
}
u:p_eopleRows := { g4:which (g1:tag, name, age, score) -> (g1:tag, g4:which s_elect name, g4:which s_elect age, g4:which s_elect score) }
t := u:p_eople ("ann" "bob" "cy", 31 42 27, 1.5 2.5 2.0)
u:p_eopleAge t
'+ r_/ u:p_eopleScore t
old := w_here 30 < u:p_eopleAge t
old u:p_eopleRows t
(g_rade u:p_eopleAge t) u:p_eopleRows t   # sorted by age

