#!/usr/bin/env xetal
## A table as columns: one array per part, side by side in a tagged
## tuple, so every operation is on a whole column and rows are taken
## from all of them at once. p_arts< writes the names. Run with
## "just demo Tags scores".

"tg:" u_se< "Tags"
SCORES := "Scores"
u:s_cores := { (player, round, points) -> (SCORES, player, round, points) }
u:s_cores? := { (g1:tag, _, _, _) -> g1:tag m_atch SCORES }
u:s_coresPlayer := { (g1:tag, g2:part, _, _) ->
  n_ot g1:tag m_atch SCORES ? "wrong-kind" []S_IGNAL "expected a Scores"
  g2:part
}
u:s_coresRound := { (g1:tag, _, g2:part, _) ->
  n_ot g1:tag m_atch SCORES ? "wrong-kind" []S_IGNAL "expected a Scores"
  g2:part
}
u:s_coresPoints := { (g1:tag, _, _, g2:part) ->
  n_ot g1:tag m_atch SCORES ? "wrong-kind" []S_IGNAL "expected a Scores"
  g2:part
}
u:s_etScoresPlayer := { g3:new (g1:tag, player, round, points) ->
  n_ot g1:tag m_atch SCORES ? "wrong-kind" []S_IGNAL "expected a Scores"
  _ := g3:new m_atch player
  (g1:tag, g3:new, round, points)
}
u:s_etScoresRound := { g3:new (g1:tag, player, round, points) ->
  n_ot g1:tag m_atch SCORES ? "wrong-kind" []S_IGNAL "expected a Scores"
  _ := g3:new m_atch round
  (g1:tag, player, g3:new, points)
}
u:s_etScoresPoints := { g3:new (g1:tag, player, round, points) ->
  n_ot g1:tag m_atch SCORES ? "wrong-kind" []S_IGNAL "expected a Scores"
  _ := g3:new m_atch points
  (g1:tag, player, round, g3:new)
}
u:s_coresRows := { g4:which (g1:tag, player, round, points) -> (g1:tag, g4:which s_elect player, g4:which s_elect round, g4:which s_elect points) }
t := u:s_cores ("ann" "bob" "ann" "cy" "bob", 1 1 2 2 2, 7 4 9 6 8)
'+ r_/ u:s_coresPoints t                                   # every point scored
(w_here 2 = u:s_coresRound t) u:s_coresRows t              # the second round's rows
(g_rade n_eg u:s_coresPoints t) u:s_coresRows t            # best first

