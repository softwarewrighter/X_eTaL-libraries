#!/usr/bin/env xetal
# Plot: text charts. Run with "just run Plot basics".
"p:" u_se< "Plot"
("apples" "pears" "plums") p:b_ars 12 30 6
p:s_park 1 2 3 5 8 13 8 5 3 2 1
p:s_park 4 4 4                               # a flat series
4 p:h_istogram 1 2 2 3 3 3 4 4 5 9
x := r_ange 20
(20 8) p:s_catter (2 20 r_eshape x c_at x * x)
svg := p:l_ine! 3 1 4 1 5 9 2 6             # a picture (written to a file by the command line)
s_hape svg
