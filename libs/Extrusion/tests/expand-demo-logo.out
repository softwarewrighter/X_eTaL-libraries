# One named arbitrary contour, with its triangles available independently.
tiledepth := 0.5
tilecontour := 2 4 r_eshape 0.0 2.0 2.0 0.0 0.0 0.0 1.0 1.0
tiletriangles := 12 3 3 r_eshape 0.0 1.0 0.25 0.0 0.0 0.25 2.0 0.0 0.25 2.0 0.0 0.25 2.0 1.0 0.25 0.0 1.0 0.25 2.0 0.0 -0.25 0.0 0.0 -0.25 0.0 1.0 -0.25 0.0 1.0 -0.25 2.0 1.0 -0.25 2.0 0.0 -0.25 0.0 0.0 -0.25 2.0 0.0 -0.25 2.0 0.0 0.25 0.0 0.0 -0.25 2.0 0.0 0.25 0.0 0.0 0.25 2.0 0.0 -0.25 2.0 1.0 -0.25 2.0 1.0 0.25 2.0 0.0 -0.25 2.0 1.0 0.25 2.0 0.0 0.25 2.0 1.0 -0.25 0.0 1.0 -0.25 0.0 1.0 0.25 2.0 1.0 -0.25 0.0 1.0 0.25 2.0 1.0 0.25 0.0 1.0 -0.25 0.0 0.0 -0.25 0.0 0.0 0.25 0.0 1.0 -0.25 0.0 0.0 0.25 0.0 1.0 0.25
