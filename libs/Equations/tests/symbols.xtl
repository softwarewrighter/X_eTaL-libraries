#!/usr/bin/env xetal
# e:t_exSymbols<: the LaTeX of e:t_ex<, each symbol the caller supplies
# (the result, array references, named scalars) in \htmlClass{sym
# sym-NAME}{...}; indices, prev, functions and numbers left plain.
# Every equation of the catalog, the CNN layer, the integrals, the scan
# and named-function tests. Run with "just run Equations symbols".
"e:" u_se< "Equations"
"$$" c_at ("c[] | " e:t_exSymbols< "(sum i:=0..2 | a[i] * bb[i]) / (sqrt((sum i:=0..2 | a[i]^2)) * sqrt((sum i:=0..2 | bb[i]^2)))") c_at "$$"
"$$" c_at ("C[i,k] | 2 2" e:t_exSymbols< "sum j:=0..2 | A[i,j] * B[j,k]") c_at "$$"
"$$" c_at ("KL[] | " e:t_exSymbols< "integral x:=-10..10 | P[x] * log(P[x] / Q[x])") c_at "$$"
"$$" c_at ("KL[] | " e:t_exSymbols< "integral x:=-10..10 by simpson 400 | (exp(-((x - m1)^2) / (2 * s1^2)) / (s1 * sqrt(2 * pi))) * log((exp(-((x - m1)^2) / (2 * s1^2)) / (s1 * sqrt(2 * pi))) / (exp(-((x - m2)^2) / (2 * s2^2)) / (s2 * sqrt(2 * pi))))") c_at "$$"
"$$" c_at ("L[] | " e:t_exSymbols< "-(sum i:=0..2 | y[i] * log(p[i]))") c_at "$$"
"$$" c_at ("L[] | " e:t_exSymbols< "(sum i:=0..3 | (yy[i] - pp[i])^2) / 4") c_at "$$"
"$$" c_at ("L[] | " e:t_exSymbols< "integral u:=0..x by simpson 32 | exp(-(u^2) / 2) / sqrt(2 * pi)") c_at "$$"
"$$" c_at ("L[] | " e:t_exSymbols< "integral x:=-10..10 by simpson 400 | (exp(-((x - m1)^2) / (2 * s1^2)) / (s1 * sqrt(2 * pi))) * log((exp(-((x - m1)^2) / (2 * s1^2)) / (s1 * sqrt(2 * pi))) / (exp(-((x - m2)^2) / (2 * s2^2)) / (s2 * sqrt(2 * pi))))") c_at "$$"
"$$" c_at ("L[] | " e:t_exSymbols< "sum i:=0..3 | (y[i] - p[i])^2 / 4") c_at "$$"
"$$" c_at ("L[] | " e:t_exSymbols< "sum i:=0..3 | (y[i] - p[i])^2") c_at "$$"
"$$" c_at ("mu[] | " e:t_exSymbols< "(sum i:=0..3 | h[i]) / 4") c_at "$$"
"$$" c_at ("O[i,k] | 2 3" e:t_exSymbols< "sum j:=0..1 | S[i,j] * V[j,k]") c_at "$$"
"$$" c_at ("p[i] | 3" e:t_exSymbols< "exp(logits[i]) / (sum j:=0..2 | exp(logits[j]))") c_at "$$"
"$$" c_at ("P[o,h,w] | 1 2 2" e:t_exSymbols< "max r:=0..1, max s:=0..1 | X[o,2*h+r,2*w+s]") c_at "$$"
"$$" c_at ("Phi[] | " e:t_exSymbols< "1 / 2 + (integral u:=0..x | exp(-(u^2) / 2) / sqrt(2 * pi))") c_at "$$"
"$$" c_at ("Phi[] | " e:t_exSymbols< "1 / 2 + (integral u:=0..x by simpson 32 | exp(-(u^2) / 2) / sqrt(2 * pi))") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< " | -2^2 + 10") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< " | 2^3^2") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "(scan t:=1..N by 0 | prev + t * t)") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "(scan t:=N..1 by 0 | prev + t * t)") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "(scan t:=N..N by 100 | prev + t)") c_at "$$"
"$$" c_at ("R[] | " e:t_exSymbols< "0.5 * (sum i:=0..2 | weights[i]^2)") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "1 + 2 * (scan t:=N..1 by 0 | prev + t)") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "d_ouble(3.0)") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "D(z)") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "exp(0.0)") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "exp(x)") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "w_eighted(1.0, 2.0, 3.0)") c_at "$$"
"$$" c_at ("r[] | " e:t_exSymbols< "w_eighted(a, b, c)") c_at "$$"
"$$" c_at ("S[i,j] | 2 2" e:t_exSymbols< "(sum d:=0..3 | Q[i,d] * K[j,d]) / sqrt(4)") c_at "$$"
"$$" c_at ("var[] | " e:t_exSymbols< "(sum i:=0..3 | (h[i] - mu)^2) / 4") c_at "$$"
"$$" c_at ("Y[i] | 4" e:t_exSymbols< "X[i] + d_ouble(X[i])") c_at "$$"
"$$" c_at ("y[n] | L-M+1" e:t_exSymbols< "sum m:=0..M-1 | xs[n+M-1-m] * hk[m]") c_at "$$"
"$$" c_at ("Y[o,h,w] | O Ho Wo" e:t_exSymbols< "sum c:=0..C - 1, sum r:=0..Kh - 1, sum s:=0..Kw - 1 | X[c,h+r,w+s] * W[o,c,r,s]") c_at "$$"
"$$" c_at ("z[i] | 2" e:t_exSymbols< "(sum j:=0..2 | W[i,j] * x[j]) + b[i]") c_at "$$"
