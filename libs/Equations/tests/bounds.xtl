#!/usr/bin/env xetal
# An index outside its axis stops the program, naming the array, the axis, the index and the expression it came from.
"e:" u_se< "Equations"
X := 2 4 4 r_eshape r_ange 32
W := 1 2 2 2 r_eshape r_ange 8
(C, Kh, Kw, O, Ho, Wo) := (2, 2, 2, 1, 3, 3)
"Y[o,h,w] | O Ho Wo" e:q_< "sum c:=0..C | X[c,h,w]"
