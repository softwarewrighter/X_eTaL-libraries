#!/usr/bin/env xetal
# An integral as an operator word of the grammar: the value by the
# written rule (trapezoid is exact on constants and lines, simpson on
# quadratics and cubics), the default trapezoid 64, Float bounds as
# written, a bound that is a caller's value, and the order of each
# rule on exp over 0..1: doubling the grid divides trapezoid's error
# by about 4 and simpson's by about 16 (the oracle: X_eTaL-ML's
# Integrals, the same call standing alone).
"e:" u_se< "Equations"
"k:" u_se< "Check"
({ @ ->
  g3:a_t := { A i -> (1 + i) s_elect r_avel A }
  g2:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g1:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  (({ @ ->
    g9:a := f_loat (0)
    g8:b := f_loat (1)
    g7:h := (g8:b - g9:a) / 2.0
    g6:w := g7:h * (1.0 c_at (1 r_eshape 4.0 2.0) c_at 1.0) / 3.0
    g10:grid := (3)
    g11:g_rid := { k ->
      g10:grid r_eshape (o_ffsets k s_elect g10:grid) 'l_eft t_able ('* r_/ k d_rop g10:grid) r_eshape 0
    }
    '+ r_/_1 g10:grid r_eshape ((1 + g11:g_rid 1) s_elect g6:w) * (((g9:a + g7:h * f_loat g11:g_rid 1) ^ 2))
  } @))
} @)
({ @ ->
  g14:a_t := { A i -> (1 + i) s_elect r_avel A }
  g13:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
