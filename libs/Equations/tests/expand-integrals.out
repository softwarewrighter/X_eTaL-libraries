    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  (({ @ ->
    g20:a := f_loat (0)
    g19:b := f_loat (2)
    g18:h := (g19:b - g20:a) / 4.0
    g17:w := g18:h * 0.5 c_at (3 r_eshape 1.0) c_at 0.5
    g21:grid := (5)
    g22:g_rid := { k ->
      g21:grid r_eshape (o_ffsets k s_elect g21:grid) 'l_eft t_able ('* r_/ k d_rop g21:grid) r_eshape 0
    }
    '+ r_/_1 g21:grid r_eshape ((1 + g22:g_rid 1) s_elect g17:w) * ((1 + (2 * (g20:a + g18:h * f_loat g22:g_rid 1))))
  } @))
} @)
