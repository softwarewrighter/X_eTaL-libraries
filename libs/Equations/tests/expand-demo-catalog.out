      ((weights, "weights", 1, "i") g76:c_heck (0 + g81:g_rid 1)))) ^ 2))
} @)))
} @), "R = 0.5 \\, \\left(\\sum_{i=0}^{2} weights_{i}^{2}\\right)"))
"$$" c_at tex11 c_at "$$"
