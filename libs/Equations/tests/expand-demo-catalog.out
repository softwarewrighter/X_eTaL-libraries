#!/usr/bin/env xetal
## Ten equations as ML papers print them, each one call: its LaTeX (a
## line between $$ is drawn as math in the live demo), its value, and
## 1 when the value equals the same computation written as plain
## X_eTaL. Run with "just demo Equations catalog".
"e:" u_se< "Equations"

### A matrix product: C[i,k] = sum_j A[i,j] B[j,k]
A := f_loat 2 3 r_eshape 1 2 3 4 5 6
B := f_loat 3 2 r_eshape 1 0 0 1 1 1
(C, tex1) := ((({ @ ->
  g3:a_t := { A i -> (1 + i) s_elect r_avel A }
  g2:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g1:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  g4:grid := 2 c_at 2
  g5:g_rid := { k -> g4:grid r_eshape (o_ffsets k s_elect g4:grid) 'l_eft t_able ('* r_/ k d_rop g4:grid) r_eshape 0 }
  g4:grid r_eshape (({ @ ->
  g6:grid := 2 c_at 2 c_at (1 + 2 - 0)
  g7:g_rid := { k -> g6:grid r_eshape (o_ffsets k s_elect g6:grid) 'l_eft t_able ('* r_/ k d_rop g6:grid) r_eshape 0 }
  '+ r_/_3 g6:grid r_eshape ((
    ((g1:r_ank (A, "A", 2, "A[i,j]")) g3:a_t ((
      ((A, "A", 2, "j") g2:c_heck (0 + g7:g_rid 3)) + (2 s_elect s_hape A) * 
      ((A, "A", 1, "i") g2:c_heck (0 + g7:g_rid 1))))) * 
    ((g1:r_ank (B, "B", 2, "B[j,k]")) g3:a_t ((
      ((B, "B", 2, "k") g2:c_heck (0 + g7:g_rid 2)) + (2 s_elect s_hape B) * 
      ((B, "B", 1, "j") g2:c_heck (0 + g7:g_rid 3)))))))
} @))
} @), "C_{i,k} = \\sum_{j=0}^{2} A_{i,j} \\, B_{j,k}"))
"$$" c_at tex1 c_at "$$"
C
C m_atch A '+ '* i_nner B

### A dense layer with its bias: z[i] = sum_j W[i,j] x[j] + b[i]
W := f_loat 2 3 r_eshape 1 2 3 4 5 6
x := f_loat 1 1 1
b := f_loat 10 20
(z, tex2) := ((({ @ ->
  g10:a_t := { A i -> (1 + i) s_elect r_avel A }
  g9:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g8:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  g11:grid := 2
  g12:g_rid := { k -> g11:grid r_eshape (o_ffsets k s_elect g11:grid) 'l_eft t_able ('* r_/ k d_rop g11:grid) r_eshape 0 }
  g11:grid r_eshape ((({ @ ->
  g13:grid := 2 c_at (1 + 2 - 0)
  g14:g_rid := { k -> g13:grid r_eshape (o_ffsets k s_elect g13:grid) 'l_eft t_able ('* r_/ k d_rop g13:grid) r_eshape 0 }
  '+ r_/_2 g13:grid r_eshape ((
    ((g8:r_ank (W, "W", 2, "W[i,j]")) g10:a_t ((
      ((W, "W", 2, "j") g9:c_heck (0 + g14:g_rid 2)) + (2 s_elect s_hape W) * 
      ((W, "W", 1, "i") g9:c_heck (0 + g14:g_rid 1))))) * 
    ((g8:r_ank (x, "x", 1, "x[j]")) g10:a_t (
      ((x, "x", 1, "j") g9:c_heck (0 + g14:g_rid 2))))))
} @) + 
    ((g8:r_ank (b, "b", 1, "b[i]")) g10:a_t (
      ((b, "b", 1, "i") g9:c_heck (0 + g12:g_rid 1))))))
} @), "z_{i} = \\left(\\sum_{j=0}^{2} W_{i,j} \\, x_{j}\\right) + b_{i}"))
"$$" c_at tex2 c_at "$$"
z
z m_atch (W '+ '* i_nner x) + b

### Attention scores and output: S = Q K^T / sqrt(d), O = S V
Q := f_loat 2 4 r_eshape 1 0 0 0 0 1 0 0
K := f_loat 2 4 r_eshape 2 0 0 0 0 2 0 0
V := f_loat 2 3 r_eshape 1 2 3 4 5 6
(S, tex3) := ((({ @ ->
  g17:a_t := { A i -> (1 + i) s_elect r_avel A }
  g16:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g15:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  g18:grid := 2 c_at 2
  g19:g_rid := { k -> g18:grid r_eshape (o_ffsets k s_elect g18:grid) 'l_eft t_able ('* r_/ k d_rop g18:grid) r_eshape 0 }
  g18:grid r_eshape ((({ @ ->
  g20:grid := 2 c_at 2 c_at (1 + 3 - 0)
  g21:g_rid := { k -> g20:grid r_eshape (o_ffsets k s_elect g20:grid) 'l_eft t_able ('* r_/ k d_rop g20:grid) r_eshape 0 }
  '+ r_/_3 g20:grid r_eshape ((
    ((g15:r_ank (Q, "Q", 2, "Q[i,d]")) g17:a_t ((
      ((Q, "Q", 2, "d") g16:c_heck (0 + g21:g_rid 3)) + (2 s_elect s_hape Q) * 
      ((Q, "Q", 1, "i") g16:c_heck (0 + g21:g_rid 1))))) * 
    ((g15:r_ank (K, "K", 2, "K[j,d]")) g17:a_t ((
      ((K, "K", 2, "d") g16:c_heck (0 + g21:g_rid 3)) + (2 s_elect s_hape K) * 
      ((K, "K", 1, "j") g16:c_heck (0 + g21:g_rid 2)))))))
} @) / (4 ^ 0.5)))
} @), "S_{i,j} = \\frac{\\sum_{d=0}^{3} Q_{i,d} \\, K_{j,d}}{\\sqrt{4}}"))
"$$" c_at tex3 c_at "$$"
S
S m_atch (Q '+ '* i_nner 2 1 t_ranspose K) / 2.0
(O, tex4) := ((({ @ ->
  g24:a_t := { A i -> (1 + i) s_elect r_avel A }
  g23:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g22:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  g25:grid := 2 c_at 3
  g26:g_rid := { k -> g25:grid r_eshape (o_ffsets k s_elect g25:grid) 'l_eft t_able ('* r_/ k d_rop g25:grid) r_eshape 0 }
  g25:grid r_eshape (({ @ ->
  g27:grid := 2 c_at 3 c_at (1 + 1 - 0)
  g28:g_rid := { k -> g27:grid r_eshape (o_ffsets k s_elect g27:grid) 'l_eft t_able ('* r_/ k d_rop g27:grid) r_eshape 0 }
  '+ r_/_3 g27:grid r_eshape ((
    ((g22:r_ank (S, "S", 2, "S[i,j]")) g24:a_t ((
      ((S, "S", 2, "j") g23:c_heck (0 + g28:g_rid 3)) + (2 s_elect s_hape S) * 
      ((S, "S", 1, "i") g23:c_heck (0 + g28:g_rid 1))))) * 
    ((g22:r_ank (V, "V", 2, "V[j,k]")) g24:a_t ((
      ((V, "V", 2, "k") g23:c_heck (0 + g28:g_rid 2)) + (2 s_elect s_hape V) * 
      ((V, "V", 1, "j") g23:c_heck (0 + g28:g_rid 3)))))))
} @))
} @), "O_{i,k} = \\sum_{j=0}^{1} S_{i,j} \\, V_{j,k}"))
"$$" c_at tex4 c_at "$$"
O
O m_atch S '+ '* i_nner V

### Softmax: p[i] = exp(z[i]) / sum_j exp(z[j])
logits := f_loat 1 2 3
(p, tex5) := ((({ @ ->
  g31:a_t := { A i -> (1 + i) s_elect r_avel A }
  g30:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g29:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  g32:grid := 3
  g33:g_rid := { k -> g32:grid r_eshape (o_ffsets k s_elect g32:grid) 'l_eft t_able ('* r_/ k d_rop g32:grid) r_eshape 0 }
  g32:grid r_eshape (((e_xp 
    ((g29:r_ank (logits, "logits", 1, "logits[i]")) g31:a_t (
      ((logits, "logits", 1, "i") g30:c_heck (0 + g33:g_rid 1))))) / ({ @ ->
  g34:grid := 3 c_at (1 + 2 - 0)
  g35:g_rid := { k -> g34:grid r_eshape (o_ffsets k s_elect g34:grid) 'l_eft t_able ('* r_/ k d_rop g34:grid) r_eshape 0 }
  '+ r_/_2 g34:grid r_eshape ((e_xp 
    ((g29:r_ank (logits, "logits", 1, "logits[j]")) g31:a_t (
      ((logits, "logits", 1, "j") g30:c_heck (0 + g35:g_rid 2))))))
} @)))
} @), "p_{i} = \\frac{\\exp(logits_{i})}{\\sum_{j=0}^{2} \\exp(logits_{j})}"))
"$$" c_at tex5 c_at "$$"
p
p m_atch (e_xp logits) / '+ r_/ e_xp logits

### Cross-entropy: L = -sum_i y[i] log(p[i])
y := f_loat 0 0 1
(ce, tex6) := ((({ @ ->
  g38:a_t := { A i -> (1 + i) s_elect r_avel A }
  g37:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g36:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  ((0 - ({ @ ->
  g41:grid := (1 + 2 - 0)
  g42:g_rid := { k -> g41:grid r_eshape (o_ffsets k s_elect g41:grid) 'l_eft t_able ('* r_/ k d_rop g41:grid) r_eshape 0 }
  '+ r_/_1 g41:grid r_eshape ((
    ((g36:r_ank (y, "y", 1, "y[i]")) g38:a_t (
      ((y, "y", 1, "i") g37:c_heck (0 + g42:g_rid 1)))) * (l_og 
    ((g36:r_ank (p, "p", 1, "p[i]")) g38:a_t (
      ((p, "p", 1, "i") g37:c_heck (0 + g42:g_rid 1)))))))
} @)))
} @), "L = -\\left(\\sum_{i=0}^{2} y_{i} \\, \\log(p_{i})\\right)"))
"$$" c_at tex6 c_at "$$"
ce
ce m_atch 0 - '+ r_/ y * l_og p

### Mean squared error: L = (1/n) sum_i (y[i] - p[i])^2
yy := f_loat 1 2 3 4
pp := 1.5 2 2 4
(mse, tex7) := ((({ @ ->
  g45:a_t := { A i -> (1 + i) s_elect r_avel A }
  g44:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g43:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  ((({ @ ->
  g48:grid := (1 + 3 - 0)
  g49:g_rid := { k -> g48:grid r_eshape (o_ffsets k s_elect g48:grid) 'l_eft t_able ('* r_/ k d_rop g48:grid) r_eshape 0 }
  '+ r_/_1 g48:grid r_eshape ((((
    ((g43:r_ank (yy, "yy", 1, "yy[i]")) g45:a_t (
      ((yy, "yy", 1, "i") g44:c_heck (0 + g49:g_rid 1)))) - 
    ((g43:r_ank (pp, "pp", 1, "pp[i]")) g45:a_t (
      ((pp, "pp", 1, "i") g44:c_heck (0 + g49:g_rid 1)))))) ^ 2))
} @) / 4))
} @), "L = \\frac{\\sum_{i=0}^{3} \\left(yy_{i} - pp_{i}\\right)^{2}}{4}"))
"$$" c_at tex7 c_at "$$"
mse
mse m_atch ('+ r_/ (yy - pp) ^ 2) / 4.0

### Layer norm's mean and variance: mu = (1/n) sum_i x[i], var = (1/n) sum_i (x[i] - mu)^2
h := f_loat 1 2 3 4
(mu, tex8) := ((({ @ ->
  g52:a_t := { A i -> (1 + i) s_elect r_avel A }
  g51:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g50:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  ((({ @ ->
  g55:grid := (1 + 3 - 0)
  g56:g_rid := { k -> g55:grid r_eshape (o_ffsets k s_elect g55:grid) 'l_eft t_able ('* r_/ k d_rop g55:grid) r_eshape 0 }
  '+ r_/_1 g55:grid r_eshape (
    ((g50:r_ank (h, "h", 1, "h[i]")) g52:a_t (
      ((h, "h", 1, "i") g51:c_heck (0 + g56:g_rid 1)))))
} @) / 4))
} @), "mu = \\frac{\\sum_{i=0}^{3} h_{i}}{4}"))
"$$" c_at tex8 c_at "$$"
(var, tex9) := ((({ @ ->
  g59:a_t := { A i -> (1 + i) s_elect r_avel A }
  g58:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g57:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  ((({ @ ->
  g62:grid := (1 + 3 - 0)
  g63:g_rid := { k -> g62:grid r_eshape (o_ffsets k s_elect g62:grid) 'l_eft t_able ('* r_/ k d_rop g62:grid) r_eshape 0 }
  '+ r_/_1 g62:grid r_eshape ((((
    ((g57:r_ank (h, "h", 1, "h[i]")) g59:a_t (
      ((h, "h", 1, "i") g58:c_heck (0 + g63:g_rid 1)))) - mu)) ^ 2))
} @) / 4))
} @), "var = \\frac{\\sum_{i=0}^{3} \\left(h_{i} - mu\\right)^{2}}{4}"))
"$$" c_at tex9 c_at "$$"
mu c_at var
(mu c_at var) m_atch 2.5 1.25

### Cosine similarity: cos = sum_i a[i] b[i] / (sqrt(sum_i a[i]^2) sqrt(sum_i b[i]^2))
a := f_loat 1 0 1
bb := f_loat 1 1 0
(cosine, tex10) := ((({ @ ->
  g66:a_t := { A i -> (1 + i) s_elect r_avel A }
  g65:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g64:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  ((({ @ ->
  g69:grid := (1 + 2 - 0)
  g70:g_rid := { k -> g69:grid r_eshape (o_ffsets k s_elect g69:grid) 'l_eft t_able ('* r_/ k d_rop g69:grid) r_eshape 0 }
  '+ r_/_1 g69:grid r_eshape ((
    ((g64:r_ank (a, "a", 1, "a[i]")) g66:a_t (
      ((a, "a", 1, "i") g65:c_heck (0 + g70:g_rid 1)))) * 
    ((g64:r_ank (bb, "bb", 1, "bb[i]")) g66:a_t (
      ((bb, "bb", 1, "i") g65:c_heck (0 + g70:g_rid 1))))))
} @) / (((({ @ ->
  g71:grid := (1 + 2 - 0)
  g72:g_rid := { k -> g71:grid r_eshape (o_ffsets k s_elect g71:grid) 'l_eft t_able ('* r_/ k d_rop g71:grid) r_eshape 0 }
  '+ r_/_1 g71:grid r_eshape ((
    ((g64:r_ank (a, "a", 1, "a[i]")) g66:a_t (
      ((a, "a", 1, "i") g65:c_heck (0 + g72:g_rid 1)))) ^ 2))
} @) ^ 0.5) * (({ @ ->
  g73:grid := (1 + 2 - 0)
  g74:g_rid := { k -> g73:grid r_eshape (o_ffsets k s_elect g73:grid) 'l_eft t_able ('* r_/ k d_rop g73:grid) r_eshape 0 }
  '+ r_/_1 g73:grid r_eshape ((
    ((g64:r_ank (bb, "bb", 1, "bb[i]")) g66:a_t (
      ((bb, "bb", 1, "i") g65:c_heck (0 + g74:g_rid 1)))) ^ 2))
} @) ^ 0.5)))))
} @), "c = \\frac{\\sum_{i=0}^{2} a_{i} \\, bb_{i}}{\\sqrt{\\sum_{i=0}^{2} a_{i}^{2}} \\, \\sqrt{\\sum_{i=0}^{2} bb_{i}^{2}}}"))
"$$" c_at tex10 c_at "$$"
cosine
cosine m_atch ('+ r_/ a * bb) / (('+ r_/ a ^ 2) ^ 0.5) * ('+ r_/ bb ^ 2) ^ 0.5

### An L2 penalty: R = lambda sum_i w[i]^2
weights := f_loat 1 -2 3
(l2, tex11) := ((({ @ ->
  g77:a_t := { A i -> (1 + i) s_elect r_avel A }
  g76:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g75:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  ((0.5 * ({ @ ->
  g80:grid := (1 + 2 - 0)
  g81:g_rid := { k -> g80:grid r_eshape (o_ffsets k s_elect g80:grid) 'l_eft t_able ('* r_/ k d_rop g80:grid) r_eshape 0 }
  '+ r_/_1 g80:grid r_eshape ((
