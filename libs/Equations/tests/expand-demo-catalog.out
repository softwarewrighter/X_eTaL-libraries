      ((X, "X", 3, "2*w+s") g83:c_heck ((2 * (0 + g88:g_rid 3)) + (0 + g88:g_rid 5))) + (3 s_elect s_hape X) * (
      ((X, "X", 2, "2*h+r") g83:c_heck ((2 * (0 + g88:g_rid 2)) + (0 + g88:g_rid 4))) + (2 s_elect s_hape X) * 
      ((X, "X", 1, "o") g83:c_heck (0 + g88:g_rid 1)))))))
