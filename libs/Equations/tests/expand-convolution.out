      g77:g_rid := { k ->
        g76:grid r_eshape (o_ffsets k s_elect g76:grid) 'l_eft t_able ('* r_/ k d_rop g76:grid) r_eshape 0
      }
      '+ r_/_2 g76:grid r_eshape ((
    ((g71:r_ank (g67:p, "g67:p", 1, "g67:p[n+g69:M-1-m]")) g73:a_t (
      ((g67:p, "g67:p", 1, "n+g69:M-1-m") g72:c_heck ((((0 + g77:g_rid 1) + g69:M) - 1) - (0 + g77:g_rid 2)))))
          * 
    ((g71:r_ank (h, "h", 1, "h[m]")) g73:a_t (
      ((h, "h", 1, "m") g72:c_heck (0 + g77:g_rid 2))))))
    } @))
  } @)
} @))) k:i_s 1 4 10 16 17 12
