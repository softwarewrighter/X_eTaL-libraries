#!/usr/bin/env xetal
# Discrete 1-D convolution and correlation as library macros over sum
# (X_eTaL Saga 42 decision 5), on the asymmetric fixture [1,2,3,4] by
# [1,2,3]: full (L + M - 1 values), same (L, centered on full) and valid
# (L - M + 1); no mode is implicit. The oracle: the sums by hand, and
# numpy's convolve and correlate (same mode centered as numpy centers it).
"e:" u_se< "Equations"
"k:" u_se< "Check"
x := 1 2 3 4
h := 1 2 3
({ @ ->
  g4:L := t_ally x
  g3:M := t_ally h
  g2:c := (g3:M - 1) d_iv 2
  g1:p := ((g3:M - 1) r_eshape 0 * 1 t_ake x) c_at x c_at (g3:M - 1) r_eshape 0 * 1 t_ake x
  ({ @ ->
    g7:a_t := { A i -> (1 + i) s_elect r_avel A }
    g6:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
      "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
    }
    g5:r_ank := { (A, name, q, ref) ->
      (t_ally s_hape A) = q ? A
      "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
    }
    g8:grid := ((g4:L + g3:M) - 1)
    g9:g_rid := { k ->
      g8:grid r_eshape (o_ffsets k s_elect g8:grid) 'l_eft t_able ('* r_/ k d_rop g8:grid) r_eshape 0
    }
    g8:grid r_eshape (({ @ ->
      g10:grid := ((g4:L + g3:M) - 1) c_at (1 + (g3:M - 1) - 0)
      g11:g_rid := { k ->
        g10:grid r_eshape (o_ffsets k s_elect g10:grid) 'l_eft t_able ('* r_/ k d_rop g10:grid) r_eshape 0
      }
      '+ r_/_2 g10:grid r_eshape ((
    ((g5:r_ank (g1:p, "g1:p", 1, "g1:p[n+g3:M-1-m]")) g7:a_t (
      ((g1:p, "g1:p", 1, "n+g3:M-1-m") g6:c_heck ((((0 + g11:g_rid 1) + g3:M) - 1) - (0 + g11:g_rid 2)))))
          * 
    ((g5:r_ank (h, "h", 1, "h[m]")) g7:a_t (
      ((h, "h", 1, "m") g6:c_heck (0 + g11:g_rid 2))))))
    } @))
  } @)
} @)
({ @ ->
  g15:L := t_ally x
  g14:M := t_ally h
  g13:c := (g14:M - 1) d_iv 2
  g12:p := ((g14:M - 1) r_eshape 0 * 1 t_ake x) c_at x c_at (g14:M - 1) r_eshape 0 * 1 t_ake x
  ({ @ ->
    g18:a_t := { A i -> (1 + i) s_elect r_avel A }
    g17:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
      "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
    }
    g16:r_ank := { (A, name, q, ref) ->
      (t_ally s_hape A) = q ? A
      "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
    }
    g19:grid := g15:L
    g20:g_rid := { k ->
      g19:grid r_eshape (o_ffsets k s_elect g19:grid) 'l_eft t_able ('* r_/ k d_rop g19:grid) r_eshape 0
    }
    g19:grid r_eshape (({ @ ->
      g21:grid := g15:L c_at (1 + (g14:M - 1) - 0)
      g22:g_rid := { k ->
        g21:grid r_eshape (o_ffsets k s_elect g21:grid) 'l_eft t_able ('* r_/ k d_rop g21:grid) r_eshape 0
      }
      '+ r_/_2 g21:grid r_eshape ((
    ((g16:r_ank (g12:p, "g12:p", 1, "g12:p[n+g14:M-1+g13:c-m]")) g18:a_t (
      ((g12:p, "g12:p", 1, "n+g14:M-1+g13:c-m") g17:c_heck (((((0 + g22:g_rid 1) + g14:M) - 1) + g13:c) - (0 + g22:g_rid 2)))))
          * 
    ((g16:r_ank (h, "h", 1, "h[m]")) g18:a_t (
      ((h, "h", 1, "m") g17:c_heck (0 + g22:g_rid 2))))))
    } @))
  } @)
} @)
({ @ ->
  g26:L := t_ally x
  g25:M := t_ally h
  g24:c := (g25:M - 1) d_iv 2
  g23:p := ((g25:M - 1) r_eshape 0 * 1 t_ake x) c_at x c_at (g25:M - 1) r_eshape 0 * 1 t_ake x
  _ := { @ ->
    g25:M <= g26:L ? @
    "valid-mode" []S_IGNAL "valid: the kernel (" c_at (f_ormat g25:M) c_at ") is longer than the signal (" c_at (f_ormat g26:L) c_at ")"
  } @
  ({ @ ->
    g29:a_t := { A i -> (1 + i) s_elect r_avel A }
    g28:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
      "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
    }
    g27:r_ank := { (A, name, q, ref) ->
      (t_ally s_hape A) = q ? A
      "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
    }
    g30:grid := ((g26:L - g25:M) + 1)
    g31:g_rid := { k ->
      g30:grid r_eshape (o_ffsets k s_elect g30:grid) 'l_eft t_able ('* r_/ k d_rop g30:grid) r_eshape 0
    }
    g30:grid r_eshape (({ @ ->
      g32:grid := ((g26:L - g25:M) + 1) c_at (1 + (g25:M - 1) - 0)
      g33:g_rid := { k ->
        g32:grid r_eshape (o_ffsets k s_elect g32:grid) 'l_eft t_able ('* r_/ k d_rop g32:grid) r_eshape 0
      }
      '+ r_/_2 g32:grid r_eshape ((
    ((g27:r_ank (x, "x", 1, "x[n+g25:M-1-m]")) g29:a_t (
      ((x, "x", 1, "n+g25:M-1-m") g28:c_heck ((((0 + g33:g_rid 1) + g25:M) - 1) - (0 + g33:g_rid 2)))))
          * 
    ((g27:r_ank (h, "h", 1, "h[m]")) g29:a_t (
      ((h, "h", 1, "m") g28:c_heck (0 + g33:g_rid 2))))))
    } @))
  } @)
} @)
({ @ ->
  g37:L := t_ally x
  g36:M := t_ally h
  g35:c := (g36:M - 1) d_iv 2
  g34:p := ((g36:M - 1) r_eshape 0 * 1 t_ake x) c_at x c_at (g36:M - 1) r_eshape 0 * 1 t_ake x
  ({ @ ->
    g40:a_t := { A i -> (1 + i) s_elect r_avel A }
    g39:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
      "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
    }
    g38:r_ank := { (A, name, q, ref) ->
      (t_ally s_hape A) = q ? A
      "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
    }
    g41:grid := ((g37:L + g36:M) - 1)
    g42:g_rid := { k ->
      g41:grid r_eshape (o_ffsets k s_elect g41:grid) 'l_eft t_able ('* r_/ k d_rop g41:grid) r_eshape 0
    }
    g41:grid r_eshape (({ @ ->
      g43:grid := ((g37:L + g36:M) - 1) c_at (1 + (g36:M - 1) - 0)
      g44:g_rid := { k ->
        g43:grid r_eshape (o_ffsets k s_elect g43:grid) 'l_eft t_able ('* r_/ k d_rop g43:grid) r_eshape 0
      }
      '+ r_/_2 g43:grid r_eshape ((
    ((g38:r_ank (g34:p, "g34:p", 1, "g34:p[n+m]")) g40:a_t (
      ((g34:p, "g34:p", 1, "n+m") g39:c_heck ((0 + g44:g_rid 1) + (0 + g44:g_rid 2)))))
          * 
    ((g38:r_ank (h, "h", 1, "h[m]")) g40:a_t (
      ((h, "h", 1, "m") g39:c_heck (0 + g44:g_rid 2))))))
    } @))
  } @)
} @)
({ @ ->
  g48:L := t_ally x
  g47:M := t_ally h
  g46:c := (g47:M - 1) d_iv 2
  g45:p := ((g47:M - 1) r_eshape 0 * 1 t_ake x) c_at x c_at (g47:M - 1) r_eshape 0 * 1 t_ake x
  ({ @ ->
    g51:a_t := { A i -> (1 + i) s_elect r_avel A }
    g50:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
