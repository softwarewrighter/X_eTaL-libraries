      (t_ally s_hape A) = q ? A
      "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
    }
    g52:grid := g48:L
    g53:g_rid := { k ->
      g52:grid r_eshape (o_ffsets k s_elect g52:grid) 'l_eft t_able ('* r_/ k d_rop g52:grid) r_eshape 0
    }
    g52:grid r_eshape (({ @ ->
      g54:grid := g48:L c_at (1 + (g47:M - 1) - 0)
      g55:g_rid := { k ->
        g54:grid r_eshape (o_ffsets k s_elect g54:grid) 'l_eft t_able ('* r_/ k d_rop g54:grid) r_eshape 0
      }
      '+ r_/_2 g54:grid r_eshape ((
    ((g49:r_ank (g45:p, "g45:p", 1, "g45:p[n+g46:c+m]")) g51:a_t (
      ((g45:p, "g45:p", 1, "n+g46:c+m") g50:c_heck (((0 + g55:g_rid 1) + g46:c) + (0 + g55:g_rid 2)))))
          * 
    ((g49:r_ank (h, "h", 1, "h[m]")) g51:a_t (
      ((h, "h", 1, "m") g50:c_heck (0 + g55:g_rid 2))))))
    } @))
  } @)
} @)
({ @ ->
  g59:L := t_ally x
  g58:M := t_ally h
  g57:c := (g58:M - 1) d_iv 2
  g56:p := ((g58:M - 1) r_eshape 0 * 1 t_ake x) c_at x c_at (g58:M - 1) r_eshape 0 * 1 t_ake x
  _ := { @ ->
