} @))) k:i_s 10 16
c4 := "correlate full" k:t_est ((({ @ ->
  g103:L := t_ally x
  g102:M := t_ally h
  g101:c := (g102:M - 1) d_iv 2
  g100:p := ((g102:M - 1) r_eshape 0 * 1 t_ake x) c_at x c_at (g102:M - 1) r_eshape 0 * 1 t_ake x
  ({ @ ->
    g106:a_t := { A i -> (1 + i) s_elect r_avel A }
    g105:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
