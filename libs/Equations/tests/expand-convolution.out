        g65:grid r_eshape (o_ffsets k s_elect g65:grid) 'l_eft t_able ('* r_/ k d_rop g65:grid) r_eshape 0
      }
      '+ r_/_2 g65:grid r_eshape ((
    ((g60:r_ank (x, "x", 1, "x[n+m]")) g62:a_t (
      ((x, "x", 1, "n+m") g61:c_heck ((0 + g66:g_rid 1) + (0 + g66:g_rid 2)))))
          * 
    ((g60:r_ank (h, "h", 1, "h[m]")) g62:a_t (
      ((h, "h", 1, "m") g61:c_heck (0 + g66:g_rid 2))))))
    } @))
  } @)
} @)
c1 := "convolve full" k:t_est ((({ @ ->
  g70:L := t_ally x
  g69:M := t_ally h
  g68:c := (g69:M - 1) d_iv 2
  g67:p := ((g69:M - 1) r_eshape 0 * 1 t_ake x) c_at x c_at (g69:M - 1) r_eshape 0 * 1 t_ake x
  ({ @ ->
    g73:a_t := { A i -> (1 + i) s_elect r_avel A }
    g72:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
      "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
    }
