#!/usr/bin/env xetal
# A reference with fewer indices than its array has axes stops the program (never a silent read of the ravel).
"e:" u_se< "Equations"
X := 2 4 4 r_eshape r_ange 32
W := 1 2 2 2 r_eshape r_ange 8
(C, Kh, Kw, O, Ho, Wo) := (2, 2, 2, 1, 3, 3)
{ @ -> g1:grid := (1 + (C - 1) - 0) c_at (1 + (Kh - 1) - 0) c_at (1 + (Kw - 1) - 0) c_at O c_at Ho c_at Wo; g2:g_rid := { k -> g1:grid r_eshape (o_ffsets k s_elect g1:grid) 'l_eft t_able ('* r_/ k d_rop g1:grid) r_eshape 0 }; g5:a_t := { A i -> (1 + i) s_elect r_avel A }; g4:c_heck := { (A, name, k, from) e -> n := k s_elect s_hape A; bad := w_here n_ot r_avel (0 <= e) & e < n; 0 = t_ally bad ? e; "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")" }; g3:r_ank := { (A, name, q, ref) -> (t_ally s_hape A) = q ? A; "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A }; '+ r_/_1 '+ r_/_2 '+ r_/_3 (((g3:r_ank (X, "X", 2, "X[c,h+r]")) g5:a_t (((X, "X", 2, "h+r") g4:c_heck ((g2:g_rid 5) + (0 + g2:g_rid 2))) + (2 s_elect s_hape X) * ((X, "X", 1, "c") g4:c_heck (0 + g2:g_rid 1)))) * ((g3:r_ank (W, "W", 4, "W[o,c,r,s]")) g5:a_t (((W, "W", 4, "s") g4:c_heck (0 + g2:g_rid 3)) + (4 s_elect s_hape W) * (((W, "W", 3, "r") g4:c_heck (0 + g2:g_rid 2)) + (3 s_elect s_hape W) * (((W, "W", 2, "c") g4:c_heck (0 + g2:g_rid 1)) + (2 s_elect s_hape W) * ((W, "W", 1, "o") g4:c_heck (g2:g_rid 4))))))) } @

