#!/usr/bin/env xetal
# Written by scripts/gen-equations-differential.py: equations drawn at
# random from the grammar, each compared (m_atch) with its value computed
# independently in Python over the same arrays; every line prints 1.
"e:" u_se< "Equations"
A := 3 3 r_eshape r_ange 9
v := 2 -1 3
w := 1 4 2
("r[] | " e:e_q< "3 - 2 * 3^1") m_atch -3
("r[] | " e:e_q< "2 - 3") m_atch -1
("r[i] | 3" e:e_q< "2^2 + (max j:=0..2 | A[i,j])") m_atch 7 10 13
("r[i] | 3" e:e_q< "(v[i]) + (w[i])") m_atch 3 3 5
("r[i] | 3" e:e_q< "((1))") m_atch 1 1 1
("r[i] | 3" e:e_q< "v[i] * (min j:=0..2 | j - j)") m_atch 0 0 0
("r[] | " e:e_q< "1") m_atch 1
("r[] | " e:e_q< "(min j:=0..2 | v[j]) - 2 + 2") m_atch -1
("r[] | " e:e_q< "1 * 2 + 1 * 3") m_atch 5
("r[i] | 3" e:e_q< "v[i] + 1") m_atch 3 0 4
("r[i] | 3" e:e_q< "3 + w[i]") m_atch 4 7 5
("r[i] | 3" e:e_q< "v[i]^2") m_atch 4 1 9
("r[i] | 3" e:e_q< "w[i] - (w[i])") m_atch 0 0 0
("r[i] | 3" e:e_q< "1") m_atch 1 1 1
("r[i] | 3" e:e_q< "i^2 * v[i] + w[i] + 2 * w[i]") m_atch 3 11 18
("r[i] | 3" e:e_q< "w[i] + v[i]") m_atch 3 3 5
("r[i] | 3" e:e_q< "i^2") m_atch 0 1 4
("r[i] | 3" e:e_q< "v[i]^2") m_atch 4 1 9
("r[i] | 3" e:e_q< "((min j:=0..2 | A[i,j]))") m_atch 1 4 7
("r[i] | 3" e:e_q< "(w[i]^1) * (max j:=0..2 | i)") m_atch 0 4 4
("r[] | " e:e_q< "(max j:=0..2 | ((v[j])))") m_atch 3
("r[i] | 3" e:e_q< "(min j:=0..2 | A[i,j])") m_atch 1 4 7
("r[i] | 3" e:e_q< "v[i] + 1") m_atch 3 0 4
("r[i] | 3" e:e_q< "(max j:=0..2 | j - i)") m_atch 2 1 0
("r[i] | 3" e:e_q< "w[i]^2") m_atch 1 16 4
("r[i] | 3" e:e_q< "(min j:=0..2 | (w[j]))") m_atch 1 1 1
("r[] | " e:e_q< "3 - 3") m_atch 0
("r[i] | 3" e:e_q< "(max j:=0..2 | w[j] - w[j]) + i") m_atch 0 1 2
("r[i] | 3" e:e_q< "((max j:=0..2 | i^2))") m_atch 0 1 4
("r[] | " e:e_q< "(min j:=0..2 | (sum k:=0..2 | 2 - 2))") m_atch 0
("r[] | " e:e_q< "3") m_atch 3
("r[] | " e:e_q< "3 * 1") m_atch 3
("r[i] | 3" e:e_q< "w[i] + v[i]") m_atch 3 3 5
("r[i] | 3" e:e_q< "i") m_atch 0 1 2
("r[i] | 3" e:e_q< "((sum j:=0..2 | (A[i,j])))") m_atch 6 15 24
("r[] | " e:e_q< "((sum j:=0..2 | 3^2))") m_atch 27
("r[i] | 3" e:e_q< "3^1") m_atch 3 3 3
("r[i] | 3" e:e_q< "v[i]") m_atch 2 -1 3
("r[i] | 3" e:e_q< "(max j:=0..2 | v[j]) + (i)") m_atch 3 4 5
("r[] | " e:e_q< "1") m_atch 1
