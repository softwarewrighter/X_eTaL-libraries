# drawn
# A program drawn as HTML (xetal render --html): each equation call's
# two strings are one c-notation span holding the LaTeX e:t_ex< gives
# (MC32), after the macro name; the values are those of the sums.
"e:" u_se< "Equations"
x := 1.0 2.0 3.0
s := "S[] | " e:e_q< "sum i:=0..2 | x[i]"
s
y := "y[n] | full" e:c_onvolve< "x x"
y
