#!/usr/bin/env xetal
# The LaTeX of a call, and the pair of value and LaTeX, from the same
# parse e:e_q< reads. A line between $$ is drawn as math by the live
# demo. Run with "just run Equations latex".
"e:" u_se< "Equations"
X := 2 4 4 r_eshape r_ange 32
W := 1 2 2 2 r_eshape r_ange 8
(C, Kh, Kw, O, Ho, Wo) := (2, 2, 2, 1, 3, 3)
tex := "Y[o,h,w] | O Ho Wo" e:t_ex< "sum c:=0..C - 1, sum r:=0..Kh - 1, sum s:=0..Kw - 1 | X[c,h+r,w+s] * W[o,c,r,s]"
"$$" c_at tex c_at "$$"
(Y, both) := "Y[o,h,w] | O Ho Wo" e:b_oth< "sum c:=0..C - 1, sum r:=0..Kh - 1, sum s:=0..Kw - 1 | X[c,h+r,w+s] * W[o,c,r,s]"
Y
both m_atch tex
Y m_atch X e:c_orrelate W
v := r_ange 10
"$$" c_at ("t[k] | 3" e:t_ex< "sum i:=0..1 | v[2*i+k]") c_at "$$"
"$$" c_at ("t[k] | 4" e:t_ex< " | v[k] * v[k]") c_at "$$"
