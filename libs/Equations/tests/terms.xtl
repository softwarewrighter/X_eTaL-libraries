#!/usr/bin/env xetal
# Sums as terms of a larger expression, the functions, and the operator
# words beside sum; each value checked by hand. Run with
# "just run Equations terms".
"e:" u_se< "Equations"
W := 2 3 r_eshape 1 2 3 4 5 6
x := 1 1 1
b := 10 20
# A dense layer with its bias: W x + b is 6 15 + 10 20.
"z[i] | 2" e:e_q< "(sum j:=0..2 | W[i,j] * x[j]) + b[i]"
# Mean squared error as printed: (sum (y - p)^2) / n.
y := f_loat 1 2 3 4
p := 1.5 2 2 4
"L[] | " e:e_q< "(sum i:=0..3 | (y[i] - p[i])^2) / 4"
# Attention scores with their scale: Q K^T / sqrt(d), Q and K the first
# two unit vectors, so the identity over 2.
Q := f_loat 2 4 r_eshape 1 0 0 0 0 1 0 0
"S[i,j] | 2 2" e:e_q< "(sum d:=0..3 | Q[i,d] * Q[j,d]) / sqrt(4)"
# Softmax: exp over the sum of exps.
z := f_loat 1 2 3
"s[i] | 3" e:e_q< "exp(z[i]) / (sum j:=0..2 | exp(z[j]))"
# Max pooling, 2 by 2 windows of one 4 by 4 channel: 6 8 / 14 16.
X := 1 4 4 r_eshape r_ange 16
"P[o,h,w] | 1 2 2" e:e_q< "max r:=0..1, max s:=0..1 | X[o,2*h+r,2*w+s]"
# A product over the index itself: 4 factorial.
"r[] | " e:e_q< "prod i:=1..4 | i"
# min and max of two values, abs and log: 2 + 7, then 3 + 0.
"r[] | " e:e_q< " | min(2, 7) + max(2, 7)"
"r[] | " e:e_q< " | abs(-3.0) + log(1.0)"
# Nested sums as terms equal the bare two-index form: 1 + 2 + 3 + 4.
A := 2 2 r_eshape 1 2 3 4
"r[] | " e:e_q< "(sum i:=0..1 | (sum j:=0..1 | A[i,j]))"
"r[] | " e:e_q< "sum i:=0..1, sum j:=0..1 | A[i,j]"
