#!/usr/bin/env xetal
# A reference with fewer indices than its array has axes stops the program (never a silent read of the ravel).
"e:" u_se< "Equations"
X := 2 4 4 r_eshape r_ange 32
W := 1 2 2 2 r_eshape r_ange 8
(C, Kh, Kw, O, Ho, Wo) := (2, 2, 2, 1, 3, 3)
"Y[o,h,w] | O Ho Wo" e:q_< "sum c:=0..C - 1, sum r:=0..Kh - 1, sum s:=0..Kw - 1 | X[c,h+r] * W[o,c,r,s]"
