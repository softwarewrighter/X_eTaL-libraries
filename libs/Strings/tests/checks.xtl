#!/usr/bin/env xetal
# Strings, checked with Check: properties that should hold.
"t:" u_se< "Strings"
"ch:" u_se< "Check"
s := "  Mixed Case text, with commas,  "
a := "upper of lower" ch:t_est (t:u_pper s) ch:i_s t:u_pper t:l_ower s
b := "split then join" ch:t_est s ch:i_s "," t:j_oin "," t:s_plit s
c := "trim is idempotent" ch:t_est (t:t_rim s) ch:i_s t:t_rim t:t_rim s
d := "words of squeeze" ch:t_est (t:w_ords s) ch:i_s t:w_ords t:s_queeze s
e := "pieces" ch:t_est 3 ch:i_s t_ally "," t:s_plit s
f := "replace back" ch:t_est s ch:i_s "#" "," t:r_eplace "," "#" t:r_eplace s
g := "width" ch:t_est 40 ch:i_s t_ally 40 t:c_enter s
ch:r_eport a ch:a_nd b ch:a_nd c ch:a_nd d ch:a_nd e ch:a_nd f ch:a_nd g
