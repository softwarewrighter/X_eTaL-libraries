#!/usr/bin/env xetal
# Strings: case, trimming, words, padding. Run with "just run Strings basics".
"t:" u_se< "Strings"
t:u_pper "Hello, World 42"
t:l_ower "Hello, World 42"
"[" c_at (t:t_rim "  two words \t\n") c_at "]"
"[" c_at (t:t_rimStart "  left ") c_at "]"
"[" c_at (t:t_rimEnd "  right ") c_at "]"
t:w_ords "  the quick  brown fox "
t_ally t:w_ords "   "
t:s_queeze "  the quick  brown fox "
"[" c_at (8 t:p_adLeft "abc") c_at "]"
"[" c_at (8 t:p_adRight "abc") c_at "]"
"[" c_at (8 t:c_enter "abc") c_at "]"
"[" c_at (2 t:p_adLeft "abc") c_at "]"      # a longer text is kept whole
3 t:r_epeat "ab"
"-" c_at (0 t:r_epeat "ab") c_at "-"
