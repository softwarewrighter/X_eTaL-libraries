#!/usr/bin/env xetal
# Numbers, checked with Check.
"n:" u_se< "Numbers"
"ch:" u_se< "Check"
v := r_ange 60
c1 := "factors multiply back" ch:t_est v ch:i_s '{ '* r_/ n:f_actors _r } e_ach v
c2 := "factors are prime" ch:t_est ch:t_rue n:p_rime? n:f_actors 2 * 3 * 5 * 7 * 11 * 13
c3 := "gcd times lcm" ch:t_est (12 * 8 9 10 21) ch:i_s (12 n:g_cd 8 9 10 21) * 12 n:l_cm 8 9 10 21
c4 := "sieve agrees with prime?" ch:t_est (n:p_rimes 200) ch:i_s (n:p_rime? r_ange 200) r_eplicate r_ange 200
s := n:i_sqrt v
c5 := "isqrt brackets n" ch:t_est ch:t_rue ((s * s) <= v) & v < (s + 1) * s + 1
c6 := "digits decode" ch:t_est 31415926 ch:i_s 10 d_ecode n:d_igits 31415926
c7 := "perfect 28" ch:t_est 56 ch:i_s '+ r_/ n:d_ivisors 28
f := n:f_ib 20
c8 := "fibonacci adds" ch:t_est (2 d_rop f) ch:i_s (-2 d_rop f) + 1 d_rop -1 d_rop f
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4 ch:a_nd c5 ch:a_nd c6 ch:a_nd c7 ch:a_nd c8
