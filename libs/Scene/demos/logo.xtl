#!/usr/bin/env xetal
# A named CPU logo scene; the vane rotates, the X remains fixed.
"sc:" u_se< "Scene"
"rt:" u_se< "RayTrace"
"logo" sc:s_cene< "# References precede their declarations.\ngroup fixed objects x\ngroup vane objects tail pivot 1.2 0 0\nobject x extrude X depth .3 material silver\nobject tail extrude _eTaL depth .2 material copper position 1.2 0 0\nmaterial copper color .8 .3 .1 reflection .2\nmaterial silver color .8 .8 .85 reflection .3\nlight key position 2 5 8 color 200 200 200\ncamera eye 3.3 1.4 10 target 3.3 .05 0 up 0 1 0 fov .36\n"
transforms := (((logopivots sc:r_otateGroup 3)_ 0.35)_ logotransforms)
triangles := ((logotriangles sc:a_pplyGroups logogroupids)_ transforms)
# A square-pixel color image; the floor receives shadows and reflections.
floor := sc:r_ectangle 3 3 r_eshape -1.0 -0.35 -4.0  0.0 0.0 8.0  9.0 0.0 0.0
mesh := triangles c_at floor
materialids := logomaterialids c_at 2 r_eshape 3
materials := logomaterials c_at 1 4 r_eshape 0.2 0.25 0.35 0.35
size := 8 4
# Small interactive workload; the published reference is rendered separately.
camera := logocamera
pixels := r_ange '* r_/ size
origins := camera rt:o_rigins t_ally pixels
directions := ((camera rt:r_ays size)_ pixels)
clip := 1e-6 100.0 1e-10 1e-5
environment := 2 3 r_eshape 0.05 0.05 0.05  0.025 0.035 0.06
linear := (((((((clip rt:r_ender mesh)_ materialids)_ materials)_ logolights)_ environment)_ origins)_ directions)
"Silver X, copper tail, hard shadows and a reflective floor."
picture := size rt:s_how! 1.3 rt:s_rgb linear
