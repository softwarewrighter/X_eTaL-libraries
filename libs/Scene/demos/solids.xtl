#!/usr/bin/env xetal
# Named declarations create bindings; ordinary functions animate and trace.
"sc:" u_se< "Scene"
"rt:" u_se< "RayTrace"
"demo" sc:s_cene2< "group moving objects crystal ball\nsphere ball center 0 0 0 radius 1 material glass\nbox crystal size 1 2 1 material glass position 2 0 0\noctahedron gem radii 1 1 1 material gray position -2 0 0\nfloor ground origin -4 -2 -3 u 0 0 6 v 8 0 0 material gray\ndielectric glass color 1 1 1 transmission 1 ior 1.5 absorption .1 .1 .1\nmaterial gray color .5 .5 .5 reflection .1\ncamera eye 0 1 6 target 0 0 0 up 0 1 0 fov .8"
transforms := (((demopivots sc:r_otateGroup 2)_ 0.35)_ demotransforms)
triangles := ((demotriangles sc:a_pplyGroups demogroupids)_ transforms)
spheres := ((demospheres sc:a_pplySphereGroups demospheregroupids)_ transforms)
pixels := r_ange 32
origins := democamera rt:o_rigins 32
directions := ((democamera rt:r_ays 8 4)_ pixels)
clip := 0.001 100.0 1e-10 0.0001
ids := ((((((clip rt:m_ixedNearest triangles)_ spheres)_ demotriangleids)_ demosphereids)_ origins)_ directions)
"Global primitive IDs, zero means miss:"
4 8 r_eshape ids
"Geometry kinds (1 triangle, 2 sphere), separate from local indices:"
4 8 r_eshape ((demotriangleids rt:h_itKinds demosphereids)_ ids)
"Local indices within each kind:"
4 8 r_eshape ((demotriangleids rt:h_itLocals demosphereids)_ ids)
"Dielectric parameters are scene data; this example traces geometry only."
