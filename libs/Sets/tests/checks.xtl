#!/usr/bin/env xetal
# Sets, checked with Check: the laws of sets on two sample vectors.
"se:" u_se< "Sets"
"ch:" u_se< "Check"
a := 5 1 4 1 5 9 2 6
b := 2 7 1 8 2 8
e := 0 r_eshape 0
c1 := "union holds both" ch:t_est ch:t_rue (a se:s_ubset? a se:u_nion b) & b se:s_ubset? a se:u_nion b
c2 := "union commutes" ch:t_est ch:t_rue (a se:u_nion b) se:s_ame? b se:u_nion a
c3 := "intersection in both" ch:t_est ch:t_rue ((a se:i_ntersect b) se:s_ubset? a) & (a se:i_ntersect b) se:s_ubset? b
c4 := "difference and intersection partition a" ch:t_est ch:t_rue (u_nique a) se:s_ame? (a se:d_ifference b) se:u_nion a se:i_ntersect b
c5 := "difference is disjoint from b" ch:t_est ch:t_rue (a se:d_ifference b) se:d_isjoint? b
c6 := "symmetric is union minus intersection" ch:t_est ch:t_rue (a se:s_ymmetric b) se:s_ame? (a se:u_nion b) se:d_ifference a se:i_ntersect b
c7 := "the empty set is a subset" ch:t_est ch:t_rue e se:s_ubset? a
c8 := "counts add up" ch:t_est (t_ally a) ch:i_s '+ r_/ se:c_ounts a
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4 ch:a_nd c5 ch:a_nd c6 ch:a_nd c7 ch:a_nd c8
