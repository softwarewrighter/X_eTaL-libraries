#!/usr/bin/env xetal
# Table-driven checks: c_ases< writes one check per row when the
# program is compiled, each named by its own source text, so a failing
# case says which without writing the expression twice. The last row
# is wrong on purpose (# shows failures). Run with "just demo Check table".
"k:" u_se< "Check"
u:c_lamp := { x -> 0 m_ax 10 m_in x }       # keep x within 0 to 10
(5) { g1:w g2:g -> g1:w m_atch g2:g ? "ok: u:c_lamp 5"; "FAIL: u:c_lamp 5: expected " c_at (f_ormat g1:w) c_at ", got " c_at f_ormat g2:g } (u:c_lamp (5))
(0) { g3:w g4:g -> g3:w m_atch g4:g ? "ok: u:c_lamp -3"; "FAIL: u:c_lamp -3: expected " c_at (f_ormat g3:w) c_at ", got " c_at f_ormat g4:g } (u:c_lamp (-3))
(10) { g5:w g6:g -> g5:w m_atch g6:g ? "ok: u:c_lamp 42"; "FAIL: u:c_lamp 42: expected " c_at (f_ormat g5:w) c_at ", got " c_at f_ormat g6:g } (u:c_lamp (42))
(1 2 3) { g7:w g8:g -> g7:w m_atch g8:g ? "ok: u:c_lamp 1 2 3"; "FAIL: u:c_lamp 1 2 3: expected " c_at (f_ormat g7:w) c_at ", got " c_at f_ormat g8:g } (u:c_lamp (1 2 3))
(11) { g9:w g10:g -> g9:w m_atch g10:g ? "ok: u:c_lamp 11"; "FAIL: u:c_lamp 11: expected " c_at (f_ormat g9:w) c_at ", got " c_at f_ormat g10:g } (u:c_lamp (11))
(6) { g11:w g12:g -> g11:w m_atch g12:g ? "ok: '+ r_/ 1 2 3"; "FAIL: '+ r_/ 1 2 3: expected " c_at (f_ormat g11:w) c_at ", got " c_at f_ormat g12:g } ('+ r_/ (1 2 3))
(5050) { g13:w g14:g -> g13:w m_atch g14:g ? "ok: '+ r_/ r_ange 100"; "FAIL: '+ r_/ r_ange 100: expected " c_at (f_ormat g13:w) c_at ", got " c_at f_ormat g14:g } ('+ r_/ (r_ange 100))

