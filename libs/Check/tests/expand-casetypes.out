#!/usr/bin/env xetal
# Expected and actual values share a type: comparing a number with a
# text is a type error when the program is compiled.
"k:" u_se< "Check"
p_rint! "this never prints"
(12) { g1:w g2:g -> g1:w m_atch g2:g ? "ok: f_ormat 12"; "FAIL: f_ormat 12: expected " c_at (f_ormat g1:w) c_at ", got " c_at f_ormat g2:g } (f_ormat (12))

