#!/usr/bin/env xetal
# Check: checks joined with a_nd, counted and reported.
# Some checks here fail on purpose, to show them (# shows failures).
"ch:" u_se< "Check"
a := "sum" ch:t_est 6 ch:i_s '+ r_/ 1 2 3
b := "reverse" ch:t_est "cba" ch:i_s r_ev "abc"
c := "mean" ch:t_est 2 ch:n_ear ('+ r_/ 1 2 3) / 3
ch:r_eport a ch:a_nd b ch:a_nd c
ch:c_ount a ch:a_nd b
ch:p_assed? a ch:a_nd b ch:a_nd c
bad := "sort" ch:t_est 1 2 3 ch:i_s s_ort 3 1 2 0
ch:r_eport a ch:a_nd bad ch:a_nd c
ch:f_ailures a ch:a_nd bad ch:a_nd bad
ch:p_assed? bad
ch:r_eport a                          # one check
# Check checks itself: the line a check gives is a value like any other.
ch:r_eport ("ok" ch:i_s 1 ch:i_s 1) ch:a_nd ("FAIL: expected 1, got 2" ch:i_s 1 ch:i_s 2) ch:a_nd "ok: x" ch:i_s "x" ch:t_est "ok"
