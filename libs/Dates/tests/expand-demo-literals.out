#!/usr/bin/env xetal
## Date literals: d_ate< turns each into its day number when the program
## is compiled, so the program holds plain numbers and nothing parses a
## date when it runs. Run with "just demo Dates literals".

"d:" u_se< "Dates"
landing := (-165)
landing
d:w_eekday landing                        # 7: a Sunday
((20812)) - (20729)   # days to go
d:i_so (11016)           # a leap day

