#!/usr/bin/env xetal
# Dates, checked with Check: round trips over four centuries.
"d:" u_se< "Dates"
"ch:" u_se< "Check"
n := -146097 + 13 * r_ange 22476          # every 13th day, 1570 to 2370
c := d:d_ate n
c1 := "civil then days is the identity" ch:t_est n ch:i_s d:d_ays c
c2 := "months 1 to 12" ch:t_est ch:t_rue ((2 s_elect c) >= 1) & (2 s_elect c) <= 12
c3 := "days within the month" ch:t_est ch:t_rue ((3 s_elect c) >= 1) & (3 s_elect c) <= (1 s_elect c) d:d_aysIn 2 s_elect c
c4 := "weekdays cycle" ch:t_est 1 2 3 4 5 6 7 ch:i_s s_ort d:w_eekday 0 1 2 3 4 5 6
c5 := "leap days in 400 years" ch:t_est 97 ch:i_s t_ally w_here d:l_eap? 2000 + o_ffsets 400
c6 := "400 years are 146097 days" ch:t_est 146097 ch:i_s (d:d_ays 2400 1 1) - d:d_ays 2000 1 1
c7 := "the epoch" ch:t_est 1970 1 1 ch:i_s d:d_ate 0
x := 2026 d:c_alendar 10
c8 := "a calendar holds the month" ch:t_est (r_ange 31) ch:i_s (0 != r_avel x) r_eplicate r_avel x
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4 ch:a_nd c5 ch:a_nd c6 ch:a_nd c7 ch:a_nd c8
