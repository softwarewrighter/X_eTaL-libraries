#!/usr/bin/env xetal
# Dates, checked with Check: round trips over four centuries.
"d:" u_se< "Dates"
"k:" u_se< "Check"
n := -146097 + 13 * r_ange 22476          # every 13th day, 1570 to 2370
c := d:c_ivil n
c1 := "civil then days is the identity" k:t_est n k:i_s d:d_ays c
c2 := "months 1 to 12" k:t_est k:t_rue ((2 s_elect c) >= 1) & (2 s_elect c) <= 12
c3 := "days within the month" k:t_est k:t_rue ((3 s_elect c) >= 1) & (3 s_elect c) <= (1 s_elect c) d:d_aysIn 2 s_elect c
c4 := "weekdays cycle" k:t_est 1 2 3 4 5 6 7 k:i_s s_ort d:w_eekday 0 1 2 3 4 5 6
c5 := "leap days in 400 years" k:t_est 97 k:i_s t_ally w_here d:l_eap? 2000 + o_ffsets 400
c6 := "400 years are 146097 days" k:t_est 146097 k:i_s (d:d_ays 2400 1 1) - d:d_ays 2000 1 1
c7 := "the epoch" k:t_est 1970 1 1 k:i_s d:c_ivil 0
x := 2026 d:c_alendar 10
c8 := "a calendar holds the month" k:t_est (r_ange 31) k:i_s (0 != r_avel x) r_eplicate r_avel x
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4 k:a_nd c5 k:a_nd c6 k:a_nd c7 k:a_nd c8
