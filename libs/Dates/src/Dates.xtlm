# Dates: its macro library -- d_ate<, date literals checked at compile time.
# Imported with the functions, under one alias: "d:" u_se< "Dates".
# A macro is a function from the source text written left and right of
# its call to the source that replaces the call, run before the program
# is compiled (X_eTaL MC10). Names with m: are macros; the others are
# private to this file.
#
# A macro library cannot call its own library's functions (Dates.xtl)
# nor name them in what it writes, so the day arithmetic is repeated
# here, privately, and d_ate< writes a plain number.

digits := "0123456789"

# The text with each "-" as a space, so n_umbers reads the three parts.
s_paced := { t ->
  n := t_ally t
  dash := t = f_irst "-"
  ((r_ange n) + dash * (n + 1) - r_ange n) s_elect t c_at " "
}

# Whether y m d is a date of the Gregorian calendar.
v_alid? := { ymd ->
  y := f_irst ymd
  m := f_irst 1 d_rop ymd
  d := f_irst 2 d_rop ymd
  (m < 1) | m > 12 ? 0 = 1
  leap := (0 = y m_od 400) | (0 = y m_od 4) & 0 != y m_od 100
  last := (m s_elect 31 28 31 30 31 30 31 31 30 31 30 31) + (m = 2) & leap
  (d >= 1) & d <= last
}

# The day number of y m d (days from 1970-01-01; Hinnant's
# days_from_civil, as Dates' d_ays computes it).
d_ayNumber := { ymd ->
  m := f_irst 1 d_rop ymd
  d := f_irst 2 d_rop ymd
  y := (f_irst ymd) - m <= 2
  era := y d_iv 400
  yoe := y - era * 400
  doy := (d - 1) + (2 + 153 * m + 9 - 12 * m > 2) d_iv 5
  doe := (yoe * 365) + (yoe d_iv 4) - (yoe d_iv 100) - doy
  (era * 146097) + doe - 719468
}

# Whether a text has the form yyyy-mm-dd (digits and two dashes).
f_ormed? := { t -> (2 = t_ally w_here t = f_irst "-") & '& r_/ t m_ember? digits c_at "-" }

# "" d:d_ate< "2026-10-03": the date's day number, worked out when the
# program is compiled (20729). A text that is not a date of the
# calendar (2026-02-30, 2026-13-01, 26-1-1x) expands to a name that
# does not exist, noSuchDate followed by its digits: an error at the
# call, before anything runs. The left text must be empty.
m:d_ate< := { l t ->
  n_ot "" m_atch l ? "dateTakesNoLeftText"
  n_ot f_ormed? t ? "noSuchDate" c_at (t m_ember? digits) r_eplicate t
  ymd := f_loor n_umbers s_paced t
  n_ot v_alid? ymd ? "noSuchDate" c_at (t m_ember? digits) r_eplicate t
  f_ormat d_ayNumber ymd
}
