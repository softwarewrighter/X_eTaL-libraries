#!/usr/bin/env xetal
# Geometry: the basics. Run with "just run Geometry basics".
"ge:" u_se< "Geometry"
sq := 2 4 r_eshape 0 2 2 0  0 0 2 2         # a 2 by 2 square, anticlockwise
ge:a_rea sq
ge:c_entroid sq
ge:d_istances sq
((p_i @) / 2.0) ge:r_otate 2 1 r_eshape 1 0   # (1, 0) a quarter turn: (0, 1)
3 ge:s_cale sq
(1 2) ge:s_cale sq
(10 -1) ge:m_ove sq
tri := 2 3 r_eshape 0 4 0  0 0 3
ge:a_rea tri
ge:c_entroid tri
pts := 2 9 r_eshape 0 4 4 0 2 1 3 2 1  0 0 4 4 2 1 3 4 2
ge:h_ull pts                                 # the four corners
