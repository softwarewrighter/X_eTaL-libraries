#!/usr/bin/env xetal
# All sample generation, camera rays and transport stay in ordinary X_eTaL.
"sc:" u_se< "Scene"
"rt:" u_se< "RayTrace"
"gl:" u_se< "Glass"
"r:" u_se< "Random"
"demo" sc:s_cene2< "lens aperture .08 focus 5\nfloor ground origin -3 -1 -3 u 0 0 6 v 6 0 0 material gray\nsphere ball center 0 0 0 radius .7 material glass\nemitter panel origin -1 2.5 -1 u 2 0 0 v 0 0 2 radiance 12 10 8\nmaterial gray color .5 .5 .5 reflection .15\ndielectric glass color 1 1 1 transmission 1 ior 1.5 absorption .05 .1 .15\ncamera eye 0 .5 5 target 0 0 0 up 0 1 0 fov .9"
world := ((demotriangles, demospheres) gl:p_reflight (demotriangleids, demosphereids, demotriangleobjectids, demosphereobjectids, demomaterialids, demospherematerialids))_ (demomaterials, demomaterialkind, demooptics, demoemission, demolights)
area := (world gl:p_reflightArea demoemitters)_ demoemitterradiance
size := 8 6
# Small interactive workload; the published reference is rendered separately.
spp := 1
pixelcount := '* r_/ size
n := pixelcount * spp
pixels := ((r_ange n) - 1) d_iv spp
samples := ((r_ange n) - 1) m_od spp
identities := o_\ ((1 c_at n) r_eshape pixels) c_at (1 c_at n) r_eshape samples
u:c_ounters := { dimension ->
  o_\ (o_\ identities) c_at ((1 c_at n) r_eshape 4294967295) c_at (1 c_at n) r_eshape dimension
}
u:c_olumns := { x y -> o_\ ((1 c_at n) r_eshape x) c_at (1 c_at n) r_eshape y }
film := (123 r:s_amples u:c_ounters 0) u:c_olumns 123 r:s_amples u:c_ounters 1
disk := r:d_isk (123 r:s_amples u:c_ounters 2) u:c_olumns 123 r:s_amples u:c_ounters 3
pinhole := (((democamera rt:r_aysAt size)_ pixels + 1)_ film)
(origins, directions) := (((democamera rt:l_ensRays demolens)_ pinhole)_ disk)
medium := world gl:m_ediums origins
(color, _, _, _, _, active, counts, clipped) := (((((((area gl:t_raceArea 0.00001 100.0 1e-10 0.000001)_ 2 3 r_eshape 0.0 0.0 0.0 0.1 0.15 0.2)_ origins)_ directions)_ medium)_ identities)_ 123 4)
image := ('+ r_/_2 (pixelcount c_at spp c_at 3) r_eshape color) / f_loat spp
"Thin lens, a glass sphere, a visible bright panel and soft shadows."
picture := size rt:s_how! 1.0 rt:s_rgb image
"Unresolved paths and clipped interior paths:"
('+ r_/ active) c_at '+ r_/ clipped
