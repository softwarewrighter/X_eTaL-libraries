(color, _, _, _, medium, active, counts, _) := (((((((scene gl:t_race 0.00001 100.0 1e-10 0.000001)_ 2 3 r_eshape 0.0 0.0 0.0 1.0 1.0 1.0)_ o)_ d)_ 64 r_eshape 0)_ (r_ange 64) - 1)_ 0 64)
