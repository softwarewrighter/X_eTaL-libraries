#!/usr/bin/env xetal
# Lists: the basics. Run with "just run Lists basics".
"li:" u_se< "Lists"
v := 3 1 4 1 5 9 2 6
li:d_eltas v
3 li:w_indows v
s_hape 9 li:w_indows v                # longer than the list: no windows
3 li:m_ovingMean v
li:r_unValues "aaabccdddd"
li:r_unLengths "aaabccdddd"
li:r_unLengths 0 r_eshape 0           # no runs
3 li:c_hunks "abcdefgh"
li:r_aze "ab" "c" "def"
2 li:s_hift v
-2 li:s_hift v
2 li:s_hift "abcde"
1 2 3 li:i_nterleave 10 20 30
"ace" li:i_nterleave "bdf"
s := 10 20 20 30 40
s li:b_search 5 10 20 25 40 99
"aeiou" li:b_search "amz"
