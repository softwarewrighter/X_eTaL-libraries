#!/usr/bin/env xetal
# Lists, checked with Check.
"li:" u_se< "Lists"
"ch:" u_se< "Check"
v := 5 5 5 2 2 7 1 1 1 1
w := 2 7 1 8 2 8 1 8 2 8 4 5 9
c1 := "runs rebuild the list" ch:t_est v ch:i_s (li:r_unLengths v) r_eplicate li:r_unValues v
c2 := "deltas sum to last minus first" ch:t_est ((f_irst -1 t_ake w) - f_irst w) ch:i_s '+ r_/ li:d_eltas w
c3 := "running sum undoes deltas" ch:t_est (1 d_rop w) ch:i_s (f_irst w) + '+ s_\ li:d_eltas w
c4 := "chunks raze back" ch:t_est w ch:i_s li:r_aze 4 li:c_hunks w
c5 := "a window of 1 is the list" ch:t_est w ch:i_s r_avel 1 li:w_indows w
c6 := "moving mean of 1" ch:t_est (f_loat w) ch:n_ear 1 li:m_ovingMean w
s := s_ort w
c7 := "binary search agrees with counting" ch:t_est ('{ t_ally w_here s <= _r } e_ach r_ange 10) ch:i_s s li:b_search r_ange 10
c8 := "shift and back: the first 3 become fill" ch:t_est ((3 r_eshape 0) c_at 3 d_rop w) ch:i_s -3 li:s_hift 3 li:s_hift w
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4 ch:a_nd c5 ch:a_nd c6 ch:a_nd c7 ch:a_nd c8
