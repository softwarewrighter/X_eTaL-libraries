#!/usr/bin/env xetal
## Polynomials written as maths: p_oly< reads the notation when the
## program is compiled and writes the coefficients in its place.
## Run with "just demo Polynomials notation".

"py:" u_se< "Polynomials"
p := @ py:p_oly< "3x^2 - 2x + 1"
p
py:t_ext p
p py:a_t 0 1 2
@ py:p_oly< "x^3 - 1"
@ py:p_oly< "-x + 0.5"
@ py:p_oly< "2x + x + 4x^2"                 # like powers are added
py:r_oots @ py:p_oly< "x^2 - 2"
