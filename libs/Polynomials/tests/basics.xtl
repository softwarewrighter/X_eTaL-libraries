#!/usr/bin/env xetal
# Polynomials: the basics. Run with "just run Polynomials basics".
"py:" u_se< "Polynomials"
p := 3 -2 1                           # 3x^2 - 2x + 1
py:t_ext p
p py:a_t 0 1 2 -1
p py:p_lus 1 1
1 1 py:t_imes 1 -1                    # (x + 1)(x - 1)
py:t_ext 1 1 py:t_imes 1 1           # (x + 1)^2
py:d_erivative p
py:i_ntegral p
py:r_oots 1 0 -2                      # x^2 - 2: plus and minus the root of 2
py:r_oots 1 -6 11 -6                  # (x - 1)(x - 2)(x - 3)
py:r_oots 1 0 1                       # x^2 + 1: no real roots
py:t_ext 1 0 -1 0 2.5
py:t_ext -1 0 0
