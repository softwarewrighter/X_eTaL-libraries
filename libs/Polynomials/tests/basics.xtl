#!/usr/bin/env xetal
# Polynomials: the basics. Run with "just run Polynomials basics".
"pl:" u_se< "Polynomials"
p := 3 -2 1                           # 3x^2 - 2x + 1
pl:t_ext p
p pl:a_t 0 1 2 -1
p pl:p_lus 1 1
1 1 pl:t_imes 1 -1                    # (x + 1)(x - 1)
pl:t_ext 1 1 pl:t_imes 1 1           # (x + 1)^2
pl:d_erivative p
pl:i_ntegral p
pl:r_oots 1 0 -2                      # x^2 - 2: plus and minus the root of 2
pl:r_oots 1 -6 11 -6                  # (x - 1)(x - 2)(x - 3)
pl:r_oots 1 0 1                       # x^2 + 1: no real roots
pl:t_ext 1 0 -1 0 2.5
pl:t_ext -1 0 0
