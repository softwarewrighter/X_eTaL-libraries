#!/usr/bin/env xetal
# Polynomials, checked with Check: identities at many points.
"pl:" u_se< "Polynomials"
"ch:" u_se< "Check"
a := 2 -3 0 5
b := 1 4 -1
x := (f_loat o_ffsets 11) - 5.0
c1 := "product evaluates as the product" ch:t_est ((a pl:a_t x) * b pl:a_t x) ch:n_ear (a pl:t_imes b) pl:a_t x
c2 := "sum evaluates as the sum" ch:t_est ((a pl:a_t x) + b pl:a_t x) ch:n_ear (a pl:p_lus b) pl:a_t x
c3 := "derivative of the integral" ch:t_est (f_loat a) ch:n_ear pl:d_erivative pl:i_ntegral a
c4 := "the integral starts at 0" ch:t_est 0.0 ch:n_ear f_irst (pl:i_ntegral a) pl:a_t 0
q := (1 -1 pl:t_imes 1 2) pl:t_imes 1 -3          # roots 1, -2, 3
c5 := "roots of a product of factors" ch:t_est -2.0 1.0 3.0 ch:n_ear pl:r_oots q
c6 := "roots are zeros" ch:t_est 0.0 0.0 0.0 ch:n_ear q pl:a_t pl:r_oots q
c7 := "a constant's derivative" ch:t_est (1 r_eshape 0.0) ch:n_ear pl:d_erivative 7
c8 := "x minus x is 0" ch:t_est "0" ch:i_s pl:t_ext 1 0 pl:p_lus -1 0
ch:r_eport c1 ch:a_nd c2 ch:a_nd c3 ch:a_nd c4 ch:a_nd c5 ch:a_nd c6 ch:a_nd c7 ch:a_nd c8
