# Control: control syntax as a macro library -- c_ase<, w_hen<, l_et<.
# Import it with an alias of your choice: "x:" u_se< "Control".
# A macro library (X_eTaL MC10): each m: name ending in < is a macro, a
# function from the source text written left and right of the call to
# the source that replaces it. X_eTaL's system macros (i_f<, u_nless<,
# e_ach<) need no library; these are the ones it does not have.
# Waiting for X_eTaL to run .xtlm files (ask X1); until then
# docs/control/check.sh tests the bodies.
#
# Every expansion is ordinary X_eTaL: the program around it is
# type-checked with it before anything runs, as if it had been written
# by hand (the branches of a choice share one type, a binding's type is
# inferred). A malformed call expands to code that fails that check.
"t:" u_se< "Strings"

# The clauses of a body: its texts between ";", trimmed.
c_lauses := { body -> '{ c -> t:t_rim d_isclose c } m_ap ";" t:s_plit body }

# Whether a clause is "value: result" (a colon and a space).
a_rm? := { c -> 0 < t_ally ": " t:f_ind c }

# One arm of a choice: a guard on the subject matching the value.
a_rm := { c ->
  p := f_irst ": " t:f_ind c
  "caseSubject m_atch (" c_at ((p - 1) t_ake c) c_at ") ? " c_at (p + 1) d_rop c
}

# The default of a choice: its last clause, or, when that is an arm
# (no default given), a name that does not exist, so the program fails
# at compile time (error[undefined-name] at noDefaultInCase).
d_efault := { missing last -> missing ? "noDefaultInCase"; last }

# "x" x:c_ase< "v1: r1; v2: r2; default": the result of the first value
# that matches x (m_atch: numbers, characters or texts), else the
# default. x is evaluated once; every result has one type.
m:c_ase< := { x body ->
  cs := c_lauses body
  last := d_isclose f_irst -1 t_ake cs
  missing := a_rm? last
  arms := (n_eg n_ot missing) d_rop cs
  "{ @ -> caseSubject := (" c_at x c_at "); " c_at ("; " t:j_oin '{ c -> a_rm d_isclose c } m_ap arms) c_at "; " c_at (missing d_efault last) c_at " } @"
}

# "c" x:w_hen< "b": run the statements b when c holds; the value is @
# either way (the dual of the system macro u_nless<).
m:w_hen< := { c b -> "{ @ -> n_ot (" c_at c c_at ") ? @; " c_at b c_at "; @ } @" }

# "a := 1; b := 2" x:l_et< "expression": the expression with those
# bindings, which are local to it (gone after it).
m:l_et< := { bindings e -> "{ @ -> " c_at bindings c_at "; " c_at e c_at " } @" }
